---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { label: 'Home', url: '/en/' },  { label: 'Privacy Policy', url: '/en/privacy-policy/' }
];

const siteUrl = "https://git-github-com-kenny-yan9-ad-site.vercel.app";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/privacy-policy' },
  { lang: 'en', url: siteUrl + '/en/privacy-policy' },
  { lang: 'x-default', url: siteUrl + '/privacy-policy' },
];
---

<BaseLayout
  title="Privacy Policy - Pet Aging Hub"
  description="Read Pet Aging Hub's privacy policy to understand how we collect, use, and protect your information."
  lang="en"
  breadcrumbs={breadcrumbs}
  hrefLangAlternates={hrefLangAlternates}>

  <div class="max-w-3xl mx-auto py-10">
    <header class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-900 mb-4">Privacy Policy</h1>
      <p class="text-sm text-slate-500">Last updated: January 2024</p>
    </header>

    <div class="prose-slate prose-lg max-w-none space-y-8">

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Overview</h2>
        <p class="text-slate-700 leading-relaxed">
          Pet Aging Hub ("we," "our," or "us") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website. Please read this policy carefully. If you disagree with its terms, please discontinue use of the site.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Information We Collect</h2>
        <h3 class="text-lg font-semibold text-slate-800 mb-3">Automatically Collected Information</h3>
        <p class="text-slate-700 leading-relaxed mb-4">
          When you visit our website, we may automatically collect certain information about your device, including:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-slate-700 mb-6">
          <li>Browser type and version</li>
          <li>Operating system</li>
          <li>Pages visited and time spent on each page</li>
          <li>Referring website addresses</li>
          <li>IP address (anonymized)</li>
        </ul>
        <p class="text-slate-700 leading-relaxed">
          This information is collected via Google Analytics (GA4) and is used only to understand how visitors use the site so we can improve our content.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Contact Form</h2>
        <p class="text-slate-700 leading-relaxed">
          If you contact us through our contact form, you provide us with your email address and the message you send. We use this information only to respond to your inquiry. We do not add you to any mailing list or share your contact details with third parties.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Cookies and Local Storage</h2>
        <p class="text-slate-700 leading-relaxed mb-4">
          We use browser <code class="bg-slate-100 px-1 rounded">localStorage</code> to remember your language preference (Chinese or English) so you are not repeatedly redirected. No personally identifiable information is stored.
        </p>
        <p class="text-slate-700 leading-relaxed">
          Third-party services (Google Analytics, Google AdSense) may also set cookies. Please refer to Google's Privacy Policy for details on how Google processes data.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Google AdSense</h2>
        <p class="text-slate-700 leading-relaxed">
          We use Google AdSense to display advertisements. Google may use cookies to serve ads based on your prior visits to this or other websites. You may opt out of personalized advertising by visiting <a href="https://www.google.com/settings/ads" class="text-blue-600 hover:text-blue-700" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Data Retention</h2>
        <p class="text-slate-700 leading-relaxed">
          We do not store personal data on our servers beyond what is necessary to respond to contact inquiries. Analytics data retained by Google Analytics is subject to Google's data retention settings (default: 14 months).
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Children's Privacy</h2>
        <p class="text-slate-700 leading-relaxed">
          This website is not directed at children under the age of 13. We do not knowingly collect personal information from children under 13. If you believe we have inadvertently collected such information, please contact us so we can delete it.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Changes to This Policy</h2>
        <p class="text-slate-700 leading-relaxed">
          We may update this Privacy Policy from time to time. The date at the top of this page indicates when it was last revised. We encourage you to review this policy periodically.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Contact</h2>
        <p class="text-slate-700 leading-relaxed">
          If you have questions about this Privacy Policy, please <a href="/en/contact/" class="text-blue-600 hover:text-blue-700">contact us</a>.
        </p>
      </section>

    </div>
  </div>
</BaseLayout>
