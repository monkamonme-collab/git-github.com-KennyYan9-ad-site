---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { label: 'Home', url: '/en/' },  { label: 'Terms of Use', url: '/en/terms/' }
];

const siteUrl = "https://git-github-com-kenny-yan9-ad-site.vercel.app";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/terms' },
  { lang: 'en', url: siteUrl + '/en/terms' },
  { lang: 'x-default', url: siteUrl + '/terms' },
];
---

<BaseLayout
  title="Terms of Use - Pet Aging Hub"
  description="Read the Terms of Use for Pet Aging Hub. By using this site, you agree to these terms."
  lang="en"
  breadcrumbs={breadcrumbs}
  hrefLangAlternates={hrefLangAlternates}>

  <div class="max-w-3xl mx-auto py-10">
    <header class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-900 mb-4">Terms of Use</h1>
      <p class="text-sm text-slate-500">Last updated: January 2024</p>
    </header>

    <div class="prose-slate prose-lg max-w-none space-y-8">

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Acceptance of Terms</h2>
        <p class="text-slate-700 leading-relaxed">
          By accessing and using Pet Aging Hub ("the Website"), you accept and agree to be bound by these Terms of Use. If you do not agree to these terms, please do not use the Website.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Use of the Website</h2>
        <p class="text-slate-700 leading-relaxed mb-4">You agree to use this Website only for lawful purposes and in a manner that does not infringe the rights of others. You may not:</p>
        <ul class="list-disc pl-6 space-y-2 text-slate-700">
          <li>Use the Website in any way that violates applicable local, national, or international laws or regulations</li>
          <li>Transmit any unsolicited or unauthorized advertising or promotional material</li>
          <li>Attempt to gain unauthorized access to any part of the Website</li>
          <li>Reproduce or redistribute our content for commercial purposes without written permission</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Educational Content Only</h2>
        <p class="text-slate-700 leading-relaxed">
          All content on this Website — including articles, calculators, checklists, and guides — is provided for educational and informational purposes only. It is not a substitute for professional veterinary advice. See our <a href="/en/disclaimer/" class="text-blue-600 hover:text-blue-700">Disclaimer</a> for full details.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Intellectual Property</h2>
        <p class="text-slate-700 leading-relaxed">
          The content, design, and layout of this Website are owned by Pet Aging Hub and are protected by applicable copyright laws. You may share links to our content and quote brief excerpts with proper attribution, but may not copy or reproduce full articles or tools without permission.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Limitation of Liability</h2>
        <p class="text-slate-700 leading-relaxed">
          To the fullest extent permitted by law, Pet Aging Hub shall not be liable for any direct, indirect, incidental, consequential, or punitive damages arising from your use of or inability to use this Website, or from reliance on any information provided herein. This includes any errors, omissions, or inaccuracies in the content.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">External Links</h2>
        <p class="text-slate-700 leading-relaxed">
          This Website may contain links to third-party websites. These links are provided for convenience only. We have no control over the content of those sites and are not responsible for their content or practices.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Changes to Terms</h2>
        <p class="text-slate-700 leading-relaxed">
          We reserve the right to modify these Terms of Use at any time. Changes will be effective immediately upon posting to the Website. Your continued use of the Website following any changes constitutes your acceptance of the new terms.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Governing Law</h2>
        <p class="text-slate-700 leading-relaxed">
          These Terms of Use shall be governed by and construed in accordance with applicable laws. Any disputes shall be resolved through good-faith negotiation wherever possible.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Contact</h2>
        <p class="text-slate-700 leading-relaxed">
          If you have questions about these Terms of Use, please <a href="/en/contact/" class="text-blue-600 hover:text-blue-700">contact us</a>.
        </p>
      </section>

    </div>
  </div>
</BaseLayout>
