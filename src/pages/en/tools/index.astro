---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSenseAd from '../../../components/AdSenseAd.astro';

const title = "Pet Age Calculators & Tools | Dog & Cat Human Age Conversion";
const description = "Free dog and cat age calculators with transparent educational models to help you explore human-age equivalents and life-stage context.";
const canonicalPath = "/en/tools";
const siteUrl = "https://www.petaginghub.com";

const breadcrumbs = [
  { label: 'Tools', url: canonicalPath }
];

const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/tools' },
  { lang: 'en', url: siteUrl + '/en/tools' },
  { lang: 'x-default', url: siteUrl + '/tools' },
];

const tools = [
  {
    href: '/en/tools/dog-age-calculator',
    emoji: '🐶',
    badge: 'Size-aware estimate',
    title: 'Dog Age Calculator',
    description: 'Estimate your dog\'s age in human years with a transparent size-aware model, then explore a general life-stage reference.',
    tags: ['Dogs', 'Life Stage', 'Size-aware'],
  },
  {
    href: '/en/tools/cat-age-calculator',
    emoji: '🐱',
    badge: 'Educational estimate',
    title: 'Cat Age Calculator',
    description: 'Estimate your cat\'s age in human years and explore a general life-stage reference for educational context.',
    tags: ['Cats', 'Life Stage', 'Educational'],
  },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} lang="en" hrefLangAlternates={hrefLangAlternates}>

  <!-- Hero -->
  <header class="max-w-4xl mx-auto px-6 pt-10 pb-8">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
      Pet Health Tools
    </h1>
    <p class="text-lg text-slate-600 leading-relaxed max-w-2xl">
      Free calculators and reference tools that help you explore your pet's life stage and care needs. They are educational estimates, not veterinary diagnoses or treatment plans.
    </p>
  </header>

  <!-- Tools Grid -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="grid md:grid-cols-2 gap-6">
      {tools.map((tool) => (
        <a href={tool.href} class="bg-white border border-slate-200 rounded-2xl p-6 hover:border-blue-300 hover:shadow-md transition-all group flex flex-col">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-4xl">{tool.emoji}</span>
            <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1 rounded-full">{tool.badge}</span>
          </div>
          <h2 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2">{tool.title}</h2>
          <p class="text-sm text-slate-600 leading-relaxed flex-1">{tool.description}</p>
          <div class="flex flex-wrap gap-2 mt-4">
            {tool.tags.map((tag) => (
              <span class="text-xs text-slate-500 bg-slate-100 px-2 py-0.5 rounded">{tag}</span>
            ))}
          </div>
          <div class="mt-4 text-sm font-medium text-blue-600 group-hover:text-blue-700">
            Open calculator →
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Ad -->
  <div class="max-w-4xl mx-auto px-6 mb-12">
    <AdSenseAd format="in-article" />
  </div>

  <!-- About section -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">About Our Tools</h2>
    <div class="prose prose-slate max-w-none space-y-4 text-slate-600">
      <p>
        Our tools use transparent educational models and may reference veterinary life-stage guidance for context. They do not replace an examination, diagnosis, or individualized advice from a veterinarian.
      </p>
      <p>
        Understanding your pet's life stage is the first step in providing the right care. A pet's breed, size, health, body condition, and lifestyle all affect how it ages. Our calculators can help you connect calendar age with general life-stage context, while your veterinarian can advise on individual care needs.
      </p>
    </div>
  </section>

  <!-- Related Articles -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Related Reading</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <a href="/blog/senior-pet-health-guide/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-lg">🏥</span>
          <span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">Senior Pet Health Guide</span>
        </div>
        <p class="text-sm text-slate-500">What changes when your pet becomes a senior — vet schedules, nutrition, mobility, and cognition.</p>
      </a>
      <a href="/blog/pet-nutrition-by-age/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-lg">🥗</span>
          <span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">Pet Nutrition by Life Stage</span>
        </div>
        <p class="text-sm text-slate-500">How nutritional needs shift from puppyhood and kittenhood through the senior years.</p>
      </a>
    </div>
  </section>

  <!-- JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Pet Health Tools",
    "description": "Free dog and cat age calculators with transparent educational models.",
    "url": siteUrl + canonicalPath,
    "hasPart": [
      {
        "@type": "WebApplication",
        "name": "Dog Age Calculator",
        "url": siteUrl + "/en/tools/dog-age-calculator"
      },
      {
        "@type": "WebApplication",
        "name": "Cat Age Calculator",
        "url": siteUrl + "/en/tools/cat-age-calculator"
      }
    ]
  })} />

</BaseLayout>
