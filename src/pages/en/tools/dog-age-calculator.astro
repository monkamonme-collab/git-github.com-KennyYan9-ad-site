---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const title = "Dog Age Calculator | AVMA Standard | Accurate Human Age Conversion";
const description = "Convert your dog's age to human years using the AVMA evidence-based formula. Understand your dog's life stage — puppy, adult, senior — for better veterinary care and nutrition planning.";
const canonicalPath = "/en/tools/dog-age-calculator";
const siteUrl = "https://www.petaginghub.com";

const breadcrumbs = [
  { label: 'Tools', url: '/en/tools' },
  { label: 'Dog Age Calculator', url: canonicalPath }
];

const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/tools/dog-age-calculator/' },
  { lang: 'en', url: siteUrl + '/en/tools/dog-age-calculator/' },
  { lang: 'x-default', url: siteUrl + '/tools/dog-age-calculator/' },
];

const lifeStages = [
  { range: '0–1 yr', human: 'Puppy → Young adult (≈15 yrs)', stage: 'puppy' },
  { range: '1–3 yrs', human: 'Young adult (15–28 human yrs)', stage: 'young' },
  { range: '3–7 yrs', human: 'Adult (28–52 human yrs)', stage: 'adult' },
  { range: '7–10 yrs', human: 'Senior (52–68 human yrs)', stage: 'senior' },
  { range: '10+ yrs', human: 'Geriatric (68+ human yrs)', stage: 'geriatric' },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} hrefLangAlternates={hrefLangAlternates}>

  <header class="max-w-4xl mx-auto px-6 pt-10 pb-8">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-4xl">🐶</span>
      <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">AVMA Standard</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">Dog Age Calculator</h1>
    <p class="text-lg text-slate-600 leading-relaxed max-w-2xl">
      Based on the <strong>American Veterinary Medical Association (AVMA)</strong> evidence-based formula, this tool converts your dog's age into human-equivalent years and identifies their life stage.
    </p>
  </header>

  <section class="max-w-4xl mx-auto px-6 mb-10">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
      <div class="max-w-sm mx-auto text-center">
        <div class="mb-6">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Dog's Age (years)</label>
          <input type="number" id="dogAge" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-center text-lg" value="3" min="0" max="30" />
        </div>
        <div class="bg-gradient-to-b from-blue-50 to-slate-50 rounded-xl p-6 mb-4">
          <p class="text-sm text-slate-500 mb-2">Equivalent human age</p>
          <p class="text-5xl font-black text-blue-600 mb-2" id="result">28 yrs</p>
          <p class="text-sm text-slate-500" id="lifeStageText">Currently: Adult</p>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-4 relative overflow-hidden border border-slate-200">
          <div id="progressFill" class="h-full transition-all duration-700 bg-blue-600 rounded-full" style="width: 30%"></div>
          <div class="absolute inset-0 flex justify-between px-2 text-[9px] text-slate-400 font-medium items-center uppercase tracking-wider">
            <span>Puppy</span><span>Adult</span><span>Senior</span><span>Geriatric</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 flex items-start gap-4">
      <div class="text-blue-600 mt-0.5">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-slate-800">Based on AVMA Canine Life Stage Guidelines</p>
        <p class="text-sm text-slate-500 mt-0.5">The American Veterinary Medical Association defines standardized life stage thresholds to guide preventive care, nutrition, and veterinary screening schedules.</p>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">How Does the Dog Age Calculator Work?</h2>
    <p class="text-slate-600">The old "1 dog year = 7 human years" rule is a myth. A 1-year-old dog is equivalent to a 15-year-old human, and by age 2 that jumps to 24 human years. After that, each dog year adds roughly 4 human years.</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Conversion Formula</h2>
    <div class="bg-white border border-slate-200 rounded-xl p-6 space-y-4">
      <div class="bg-slate-50 rounded-lg p-4 font-mono text-sm text-slate-600">
        <p>Age 1 yr → 15 human yrs | Age 2 yrs → 24 human yrs | Each additional yr → +4 human yrs</p>
      </div>
      <p class="text-xs text-slate-500">Source: AVMA. <em>Canine Life Stage Guidelines</em>. JAVMA, 2019; 255(1): 1-16.</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Dog Life Stage Reference Chart</h2>
    <div class="grid gap-4">
      {lifeStages.map((stage) => (
        <div class="bg-white border border-slate-200 rounded-xl p-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class={`inline-block text-xs font-bold px-2 py-0.5 rounded mb-2 ${stage.stage === 'puppy' ? 'bg-pink-100 text-pink-700' : stage.stage === 'young' ? 'bg-orange-100 text-orange-700' : stage.stage === 'adult' ? 'bg-green-100 text-green-700' : stage.stage === 'senior' ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700'}`}>{stage.range}</span>
              <p class="text-slate-600">{stage.human}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">Does breed size affect when a dog becomes a senior?</summary>
        <div class="px-5 pb-5 text-slate-600">Yes. Small breeds typically reach senior status around 10–12 years, large breeds around 7 years, and giant breeds even earlier. This calculator uses the AVMA general baseline.</div>
      </details>
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">At what age does the senior life stage begin?</summary>
        <div class="px-5 pb-5 text-slate-600">Most dogs enter the senior stage around 7 years (≈44 human years) per AVMA guidelines. At 7+, dogs benefit from biannual vet visits, early cancer screening, and joint health monitoring.</div>
      </details>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Related Calculators & Articles</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <a href="/en/tools/cat-age-calculator/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-2"><span class="text-2xl">🐱</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">Cat Age Calculator</span></div>
        <p class="text-sm text-slate-500">Convert your cat's age using AAHA/AVMA guidelines.</p>
      </a>
      <a href="/blog/senior-pet-health-guide/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-2 mb-2"><span class="text-lg">🏥</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">Senior Pet Health Guide</span></div>
        <p class="text-sm text-slate-500">Everything you need to know about caring for aging pets.</p>
      </a>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="border-t border-slate-200 pt-8">
      <p class="text-xs text-slate-500 leading-relaxed"><strong>Disclaimer:</strong> This calculator is based on AVMA guidelines for general educational purposes only. It does not constitute veterinary advice. Always consult a licensed veterinarian for health decisions specific to your dog.</p>
    </div>
  </section>

  <nav class="max-w-4xl mx-auto px-6 pb-12 flex justify-between items-center text-sm">
    <a href="/en/tools/cat-age-calculator/" class="text-blue-600 hover:text-blue-700 font-medium">← Cat Age Calculator</a>
    <a href="/en/tools/" class="text-blue-600 hover:text-blue-700 font-medium">All Tools →</a>
  </nav>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebApplication","name":"Dog Age Calculator","description":"Convert dog years to human years using the AVMA evidence-based formula.","url":siteUrl + canonicalPath,"applicationCategory":"UtilitiesApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}})} />

  <script>
    const ageInput = document.getElementById('dogAge') as HTMLInputElement;
    const resultDisplay = document.getElementById('result');
    const lifeStageText = document.getElementById('lifeStageText');
    const progressFill = document.getElementById('progressFill');
    const getStage = (age: number): { text: string; progress: number } => {
      if (age <= 0) return { text: 'Newborn', progress: 5 };
      if (age === 1) return { text: 'Young Adult', progress: 10 };
      if (age === 2) return { text: 'Full Maturity', progress: 15 };
      if (age < 7) return { text: 'Adult', progress: 20 + (age - 2) * 6 };
      if (age < 11) return { text: 'Senior', progress: 50 + (age - 7) * 10 };
      return { text: 'Super Senior', progress: Math.min(90 + (age - 11) * 3, 100) };
    };
    const update = () => {
      const age = parseInt(ageInput.value) || 0;
      const humanAge = age <= 0 ? 0 : age === 1 ? 15 : age === 2 ? 24 : 24 + (age - 2) * 4;
      const { text, progress } = getStage(age);
      if (resultDisplay) resultDisplay.textContent = `${humanAge} yrs`;
      if (lifeStageText) lifeStageText.textContent = `Currently: ${text}`;
      if (progressFill) progressFill.style.width = `${progress}%`;
    };
    ageInput.addEventListener('input', update);
    update();
  </script>
</BaseLayout>
