---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
---
<BaseLayout title="部落格">
  <div class="max-w-5xl mx-auto py-12 px-6">
    <h1 class="text-3xl font-bold mb-6">部落格文章</h1>
    <div class="grid md:grid-cols-2 gap-8">
      <Card href="/blog/seo-checker-guide" className="h-full hover:shadow-lg transition-all duration-300 hover:border-blue-500">
        <h2 class="text-xl font-bold text-slate-900 mb-2">SEO 工具推薦</h2>
        <p class="text-slate-600 text-sm">了解如何使用 SEO 工具提升網站排名</p>
      </Card>
      <Card href="/blog/ai-writing-assistant-guide" className="h-full hover:shadow-lg transition-all duration-千年暦 300 hover:border-blue-500">
        <h2 class="text-xl font-bold text-slate-900 mb-2">AI 寫作助手指南</h2>
        <p class="text-slate-600 text-sm">學習如何利用 AI 提升內容創作效率</p>
      </Card>
    </div>
  </div>
</BaseLayout>