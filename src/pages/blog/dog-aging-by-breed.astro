---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';

const title = "狗狗品種與老化速度：從吉娃娃到拉布拉多，各體型與品種的老年時程";
const description = "不同品種的狗狗老化速度差異極大。本指南整理常見品種的老化時間表，幫助主人提前根據體型準備老年照護。";
const date = "2026-05-12";
const image = "https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=1200&q=80";

const siteUrl = "https://git-github-com-kenny-yan9-ad-site.vercel.app";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/blog/dog-aging-by-breed' },
  { lang: 'x-default', url: siteUrl + '/blog/dog-aging-by-breed' },
];
---

<BaseLayout title={title} description={description} lang="zh-TW" hrefLangAlternates={hrefLangAlternates}>
  <div class="bg-gradient-to-br from-amber-50 to-orange-50 border-b border-amber-100">
    <div class="max-w-4xl mx-auto px-6 py-12 text-center">
      <nav class="text-sm text-slate-500 mb-4 font-medium">
        <a href="/" class="hover:text-blue-600">首頁</a>
        <span class="mx-2">/</span>
        <a href="/blog/" class="hover:text-blue-600">部落格</a>
        <span class="mx-2">/</span>
        <span class="text-slate-400">狗狗品種與老化速度</span>
      </nav>
      <div class="inline-flex items-center gap-2 bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1.5 rounded-full mb-4">
        🐕 品種健康研究
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-6 leading-tight">
        狗狗品種與老化速度：<br class="hidden md:block" />
        各體型與品種的老年時程
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        為什麼大丹犬 6 歲就算老？而吉娃娃 12 歲還像青少年？了解品種背後的生理時鐘，才能給予最精準的照護。
      </p>
      <div class="flex items-center justify-center gap-4 mt-8 text-sm text-slate-500 font-medium">
        <span>更新時間：{date}</span>
        <span>·</span>
        <span>閱讀時間：約 12 分鐘</span>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-6 mt-[-2rem] md:mt-0 md:px-6">
    <img
      src={image}
      alt="不同體型狗狗的生命階段對比圖"
      class="w-full aspect-video object-cover rounded-3xl shadow-2xl border-4 border-white"
    />
  </div>

  <div class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-inner">
    <div class="max-w-4xl mx-auto px-6 py-8 text-center">
      <p class="text-base mb-4 opacity-95 font-medium">想知道你家狗狗對應的人類年齡嗎？</p>
      <a
        href="/tools/dog-age-calculator/"
        class="inline-flex items-center gap-2 bg-white text-blue-700 font-bold px-8 py-3.5 rounded-2xl hover:bg-blue-50 transition-all shadow-lg hover:scale-105"
      >
        🐕 狗狗年齡計算機 →
      </a>
    </div>
  </div>

  <article class="max-w-3xl mx-auto px-6 py-12">
    <div class="bg-amber-50 border-l-4 border-amber-400 p-6 rounded-r-2xl my-8 shadow-sm">
      <h3 class="font-bold text-amber-900 mb-4 flex items-center gap-2 text-lg">
        <span>📌</span> 本篇重點
      </h3>
      <ul class="space-y-2 text-slate-700 text-base leading-relaxed">
        <li class="flex gap-2"><strong>·</strong> 大型犬老化速度極快，6 歲即進入老年階段。</li>
        <li class="flex gap-2"><strong>·</strong> 小型犬與玩具犬平均壽命最長，照護重點在於心臟與牙齒。</li>
        <li class="flex gap-2"><strong>·</strong> 體重每增加 2kg，預期壽命可能減少約一個月。</li>
      </ul>
    </div>

    <section id="size-differences" class="prose prose-slate max-w-none">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 border-b pb-2">為什麼大型犬老得快？</h2>
      <p>根據「Gompertz-Makeham 老化法則」，大型犬的細胞分裂頻率更高、氧化壓力更大。這意味著牠們的身體器官在更短的時間內承受了更多的消耗。</p>
      
      [Image of aging correlation with dog size]

      <AdSenseAd format="in-article" />

      <h2 id="size-chart" class="text-2xl font-bold text-slate-900 mt-12 mb-6 border-b pb-2">體型分類與老化分水嶺</h2>
      <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-sm mb-8">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-700 border-b">
            <tr>
              <th class="p-4 text-left">體型類別</th>
              <th class="p-4 text-left">老化開始時間</th>
              <th class="p-4 text-left">主要關注點</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 font-bold text-red-700">巨型犬 (>50kg)</td>
              <td class="p-4">5-6 歲</td>
              <td class="p-4">關節、骨肉瘤、心臟</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 font-bold text-orange-700">大型犬 (25-50kg)</td>
              <td class="p-4">6-7 歲</td>
              <td class="p-4">癌症、髖關節退化</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 font-bold text-green-700">小型犬 (<10kg)</td>
              <td class="p-4">9-11 歲</td>
              <td class="p-4">牙周病、二尖瓣心臟病</td>
            </tr>
          </tbody>
        </table>
      </div>

      <AdSenseAd format="in-article" />

      <h2 id="care-strategies" class="text-2xl font-bold text-slate-900 mt-12 mb
