---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';

const title = "貓咪體重與老化速度：室內貓、室外貓與大型品種的年齡對照";
const description = "你的貓是嬌小的室內貓還是結實的大型緬甸貓？不同體型的貓咪老化速度差異大。這份指南幫助你根據貓咪的體重和品種，了解牠的老年時間表。";
// 建議增加 date 變數，讓 index.astro 可以排序
const date = "2024-01-01";
const image = "https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=1200&h=675&fit=crop&fm=webp";

const siteUrl = "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/blog/cat-aging-by-weight' },
  { lang: 'x-default', url: siteUrl + '/blog/cat-aging-by-weight' },
];
---

<BaseLayout title={title} description={description} lang="zh-TW" hrefLangAlternates={hrefLangAlternates}>
  <div class="bg-gradient-to-br from-purple-50 to-indigo-50 border-b border-purple-100">
    <div class="max-w-4xl mx-auto px-6 py-12 text-center">
      <nav class="text-sm text-slate-500 mb-4">
        <a href="/" class="hover:text-blue-600">首頁</a>
        <span class="mx-2">/</span>
        <a href="/blog/" class="hover:text-blue-600">部落格</a>
        <span class="mx-2">/</span>
        <span class="text-slate-400">貓咪體重與老化速度</span>
      </nav>
      <div class="inline-flex items-center gap-2 bg-purple-100 text-purple-800 text-xs font-bold px-3 py-1.5 rounded-full mb-4">
        🐱 健康與照護
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4 leading-tight">
        貓咪體重與老化速度：<br class="hidden md:block" />
        室內貓、室外貓與大型品種的年齡對照
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">{description}</p>
      <div class="flex items-center justify-center gap-4 mt-6 text-sm text-slate-500">
        <span>最後更新：{date}</span>
        <span>·</span>
        <span>閱讀時間：約10分鐘</span>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-6 mt-[-2rem] md:mt-0 md:px-6">
    <img
      src={image}
      alt="室內老年貓在陽光下休息"
      class="w-full aspect-video object-cover rounded-2xl shadow-lg"
    />
  </div>

  <article class="max-w-3xl mx-auto px-6 py-12">
    <div class="bg-amber-50 border-l-4 border-amber-400 p-5 rounded-r-xl my-6">
      <h3 class="font-bold text-amber-800 mb-3 flex items-center gap-2">
        <span>📌</span> 本篇重點
      </h3>
      <ul class="list-disc pl-5 space-y-1 text-slate-700 text-sm">
        <li>室內貓壽命顯著長於室外貓</li>
        <li>體重管理是決定老年健康質量的關鍵</li>
        <li>大型品種需要特別注意關節與心臟問題</li>
      </ul>
    </div>

    <p class="text-lg text-slate-700 leading-relaxed mb-6">
      與狗狗不同，貓咪的體重差異雖然較小，但<strong>體重對老化的影響卻極為顯著</strong>。本指南將探討體重如何決定貓咪的老年時間表。
    </p>

    <AdSenseAd format="in-article" />

    <div class="bg-slate-50 rounded-2xl p-6 my-10 border border-slate-100">
      <h2 class="text-lg font-bold text-slate-900 mb-4">文章目錄</h2>
      <ul class="space-y-2 text-sm text-indigo-600">
        <li><a href="#why-weight-matters" class="hover:underline">1. 為什麼體重對貓咪老化很重要</a></li>
        <li><a href="#weight-categories" class="hover:underline">2. 室內貓體重分類與老化時間表</a></li>
        <li><a href="#obesity-risks" class="hover:underline">3. 肥胖對老化的影響</a></li>
      </ul>
    </div>

    <section id="why-weight-matters" class="mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">1. 為什麼體重對貓咪老化很重要</h2>
      <p class="text-slate-700 leading-relaxed mb-4">
        肥胖貓咪的壽命平均比正常體重貓咪縮短 <strong>2-3 年</strong>。腎臟病、關節炎是老貓最常見的併發症，而體重過重會加劇這些壓力。
      </p>
      [Image of feline body condition score chart]
    </section>

    <section id="weight-categories" class="mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">2. 室內貓體重分類與老化時間表</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border-collapse">
          <thead class="bg-slate-100">
            <tr>
              <th class="p-3">類別</th>
              <th class="p-3">體重</th>
              <th class="p-3">進入老年</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="p-3 font-medium">小型貓</td><td class="p-3">2-3kg</td><td class="p-3">12歲+</td></tr>
            <tr><td class="p-3 font-medium">標準貓</td><td class="p-3">3.5-5kg</td><td class="p-3">11歲+</td></tr>
            <tr><td class="p-3 font-medium text-red-600">肥胖個體</td><td class="p-3 text-red-600">>6kg</td><td class="p-3 text-red-600">9歲+</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <AdSenseAd format="in-article" />

    <section id="obesity-risks" class="mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">3. 肥胖對老化的影響</h2>
      <p class="text-slate-700 leading-relaxed mb-4">
        當貓咪步入老年，新陳代謝會減慢約 20-30%。此時如果沒有調整食量，脂肪會迅速堆積在器官周圍，增加心臟負擔。
      </p>
      [Image of cat health checkup]
    </section>

    <section id="faq" class="bg-slate-50 rounded-2xl p-8 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">常見問題解答</h2>
      <div class="space-y-4">
        <details class="group">
          <summary class="font-bold cursor-pointer list-none py-3 border-b">貓咪幾歲算老年？</summary>
          <p class="py-4 text-slate-600">通常 7 歲進入熟齡期，11 歲進入老年期。</p>
        </details>
      </div>
    </section>

  </article>

  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "貓咪體重與老化速度：室內貓、室外貓與大型品種的年齡對照",
      "author": { "@type": "Organization", "name": "Pet Aging Hub" },
      "datePublished": "2024-01-01"
    }
  </script>
</BaseLayout>
