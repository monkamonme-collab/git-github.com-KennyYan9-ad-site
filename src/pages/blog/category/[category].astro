---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { category: 'health' } },
    { params: { category: 'nutrition' } },
    { params: { category: 'care' } },
    { params: { category: 'travel' } },
    { params: { category: 'education' } },
  ];
}

const { category } = Astro.params;

const categoryInfo = {
  health: {
    name: '寵物健康',
    icon: '💊',
    description: '健康檢查、疾病預防、醫療照護',
    color: 'blue'
  },
  nutrition: {
    name: '寵物營養',
    icon: '🍖',
    description: '飲食指南、營養建議、食品安全',
    color: 'green'
  },
  care: {
    name: '寵物照護',
    icon: '🛁',
    description: '日常護理、清潔保養、生活管理',
    color: 'purple'
  },
  travel: {
    name: '寵物旅行',
    icon: '✈️',
    description: '出行準備、交通須知、旅遊攻略',
    color: 'amber'
  },
  education: {
    name: '寵物教育',
    icon: '📚',
    description: '訓練技巧、行為教育、社會化',
    color: 'rose'
  },
};

const info = categoryInfo[category] || {
  name: '未知分類',
  icon: '📂',
  description: '敬請期待更多內容',
  color: 'slate'
};

const allCategories = Object.entries(categoryInfo).map(([slug, data]) => ({
  slug,
  ...data
}));
---

<BaseLayout
  title={`${info.name}分類 | 寵物部落格`}
  description={info.description}
>
  <main class="max-w-5xl mx-auto px-6 py-12">
    <!-- 返回連結 -->
    <a href="/blog/" class="inline-flex items-center text-blue-600 hover:text-blue-800 mb-8">
      <span>←</span>
      <span class="ml-1">返回部落格</span>
    </a>

    <!-- 分類標題 -->
    <header class="text-center mb-12">
      <div class="text-6xl mb-4">{info.icon}</div>
      <h1 class="text-4xl font-extrabold text-slate-900 mb-4">{info.name}</h1>
      <p class="text-lg text-slate-600">{info.description}</p>
    </header>

    <!-- 其他分類連結 -->
    <nav class="mb-12">
      <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-4">探索其他分類</h2>
      <div class="flex flex-wrap gap-3">
        {allCategories
          .filter((cat) => cat.slug !== category)
          .map((cat) => (
            <a
              href={`/blog/category/${cat.slug}/`}
              class="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-full text-slate-700 text-sm transition-colors"
            >
              <span class="mr-1">{cat.icon}</span>
              {cat.name}
            </a>
          ))}
      </div>
    </nav>

    <!-- 文章列表（目前為空） -->
    <section>
      <h2 class="text-2xl font-bold text-slate-900 mb-8">
        {info.name}文章
        <span class="text-sm font-normal text-slate-500 ml-2">即將推出</span>
      </h2>

      <!-- 提示 -->
      <div class="bg-slate-50 rounded-2xl p-12 text-center">
        <div class="text-4xl mb-4">📝</div>
        <p class="text-slate-600">
          {info.name}相關文章正在準備中，敬請期待！
        </p>
        <p class="text-sm text-slate-500 mt-2">
          我們的專家團隊正在為您撰寫優質內容
        </p>
      </div>
    </section>

    <!-- 相關工具連結 -->
    <section class="mt-16 py-12 border-t border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900 mb-8 text-center">相關實用工具</h2>
      <div class="grid md:grid-cols-2 gap-6 max-w-2xl mx-auto">
        <a
          href="/tools/dog-age-calculator/"
          class="bg-blue-50 hover:bg-blue-100 rounded-2xl p-6 transition-colors group"
        >
          <h3 class="font-bold text-slate-900 mb-2 group-hover:text-blue-700">🐕 狗狗年齡計算機</h3>
          <p class="text-sm text-slate-600">使用 AVMA 科學演算法，計算狗狗的人類年齡</p>
        </a>
        <a
          href="/tools/cat-age-calculator/"
          class="bg-purple-50 hover:bg-purple-100 rounded-2xl p-6 transition-colors group"
        >
          <h3 class="font-bold text-slate-900 mb-2 group-hover:text-purple-700">🐱 貓咪年齡計算機</h3>
          <p class="text-sm text-slate-600">了解愛貓的生命階段與照護重點</p>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>