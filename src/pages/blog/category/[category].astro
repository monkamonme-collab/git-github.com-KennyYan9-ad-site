---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { category: 'health' } },
    { params: { category: 'nutrition' } },
    { params: { category: 'care' } },
  ];
}

const { category } = Astro.params;
---

<BaseLayout title={`${category} 分類 - Pet Aging Hub`}>
  <div class="max-w-5xl mx-auto py-20 text-center">
    <h1 class="text-3xl font-bold capitalize">{category} 相關文章</h1>
    <p class="mt-4 text-slate-500">內容建置中，請回到 <a href="/blog/" class="text-blue-600">部落格首頁</a> 查看最新文章。</p>
  </div>
</BaseLayout>
