---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

// 必須在 --- 之內執行抓取
const allPosts = await Astro.glob('./*.astro');
const displayPosts = allPosts
  .filter(post => !post.file.includes('index.astro') && post.frontmatter?.title)
  .sort((a, b) => (new Date(b.frontmatter?.date || 0).getTime() - new Date(a.frontmatter?.date || 0).getTime()))
  .slice(0, 9);

const categories = [
  { name: '寵物健康', slug: 'health', icon: '💊' },
  { name: '寵物營養', slug: 'nutrition', icon: '🍖' },
  { name: '寵物照護', slug: 'care', icon: '🛁' },
];
---

<BaseLayout title="部落格 | 寵物知識與專業指南">
  <main class="max-w-5xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-bold text-center mb-12">寵物健康部落格</h1>
    
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      {displayPosts.map((post) => (
        <a href={post.url}>
          <Card>
             <img src={post.frontmatter.image} alt={post.frontmatter.title} />
             <h3 class="p-4 font-bold">{post.frontmatter.title}</h3>
          </Card>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
