---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { category: 'health' } },
    { params: { category: 'nutrition' } },
    { params: { category: 'care' } },
  ];
}

const { category } = Astro.params;
---

<BaseLayout title={`${category} 分類 - Pet Aging Hub`}>
  <div class="max-w-5xl mx-auto py-20 text-center px-6">
    <h1 class="text-4xl font-bold capitalize text-slate-900">{category} 相關文章</h1>
    <p class="mt-6 text-slate-500 text-lg">內容正在快馬加鞭上架中...</p>
    <a href="/blog/" class="mt-8 inline-block bg-blue-600 text-white px-8 py-3 rounded-xl font-bold">回到部落格首頁</a>
  </div>
</BaseLayout>
