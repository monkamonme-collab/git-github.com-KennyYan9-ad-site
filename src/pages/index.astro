---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
---

<BaseLayout
  title="了解你的寵物：狗狗與貓咪年齡計算機與老年照護指南"
  description="簡單的工具與實用指南，幫助你了解狗狗和貓咪的老化過程、健康變化與老年照護需求。"
>

  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-amber-50 to-white border-b border-amber-100">
    <div class="max-w-4xl mx-auto px-6 py-16 text-center">
      <div class="inline-flex items-center gap-2 bg-amber-100 text-amber-800 text-sm font-medium px-4 py-2 rounded-full mb-6">
        <span class="text-lg">🐾</span>
        <span>寵物年齡與健康資源</span>
      </div>

      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 leading-tight">
        了解你的寵物<br class="hidden md:block" />
        年齡與健康
      </h1>

      <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed">
        簡單的工具與實用指南，幫助你了解狗狗和貓咪的老化過程、健康變化與老年照護需求。
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/tools/dog-age-calculator/"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-xl transition-colors shadow-md"
        >
          <span class="text-xl">🐕</span>
          狗狗年齡計算機
        </a>
        <a
          href="/tools/cat-age-calculator/"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-slate-700 hover:bg-slate-800 text-white font-semibold rounded-xl transition-colors shadow-md"
        >
          <span class="text-xl">🐱</span>
          貓咪年齡計算機
        </a>
      </div>
    </div>
  </div>

  <!-- Trust Banner -->
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-6 py-6">
      <div class="flex flex-wrap justify-center gap-8 md:gap-16 text-center">
        <div>
          <p class="text-2xl font-bold text-slate-900">6+</p>
          <p class="text-sm text-slate-600">實用工具</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-slate-900">8+</p>
          <p class="text-sm text-slate-600">專業文章</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-slate-900">30+</p>
          <p class="text-sm text-slate-600">狗狗與貓咪品種</p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-12">

    <!-- Featured Guides Section -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
            <span class="text-2xl">📚</span>
            精選指南
          </h2>
          <p class="text-slate-600 mt-1">深入了解寵物老化與健康</p>
        </div>
        <a href="/blog/" class="text-amber-600 hover:text-amber-700 font-medium text-sm flex items-center gap-1">
          所有文章 →
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <a href="/blog/senior-pet-health-guide/" class="group block">
          <Card className="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300">
            <div class="flex items-start gap-4">
              <span class="text-4xl">📋</span>
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2 py-1 bg-purple-100 text-purple-700 text-xs font-bold rounded-full">旗艦文章</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">老年寵物健康完整指南</h3>
                <p class="text-sm text-slate-600 mb-3">從營養需求到環境調整，全方位解析7歲以上寵物的照護要點</p>
                <span class="text-xs text-slate-500">閱讀時間：約15分鐘</span>
              </div>
            </div>
          </Card>
        </a>

        <a href="/blog/dog-vs-cat-aging/" class="group block">
          <Card className="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300">
            <div class="flex items-start gap-4">
              <span class="text-4xl">📊</span>
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-bold rounded-full">比較分析</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">狗與貓老化差異完整比較</h3>
                <p class="text-sm text-slate-600 mb-3">9個維度全面對比：老化速度、壽命、老年常見疾病與照護重點</p>
                <span class="text-xs text-slate-500">閱讀時間：約10分鐘</span>
              </div>
            </div>
          </Card>
        </a>

        <a href="/blog/dog-aging-by-breed/" class="group block">
          <Card className="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300">
            <div class="flex items-start gap-4">
              <span class="text-4xl">🐕</span>
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">狗狗</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">狗狗品種與老化速度</h3>
                <p class="text-sm text-slate-600 mb-3">從吉娃娃到大丹犬，15+品種的老化時間表與照護建議</p>
                <span class="text-xs text-slate-500">閱讀時間：約12分鐘</span>
              </div>
            </div>
          </Card>
        </a>

        <a href="/blog/cat-aging-by-weight/" class="group block">
          <Card className="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300">
            <div class="flex items-start gap-4">
              <span class="text-4xl">🐱</span>
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2 py-1 bg-purple-100 text-purple-700 text-xs font-bold rounded-full">貓咪</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">貓咪體重與老化速度</h3>
                <p class="text-sm text-slate-600 mb-3">室內貓、室外貓與大型品種的年齡對照，肥胖對壽命的影響</p>
                <span class="text-xs text-slate-500">閱讀時間：約10分鐘</span>
              </div>
            </div>
          </Card>
        </a>
      </div>
    </section>

    <!-- Popular Calculators Section -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
            <span class="text-2xl">🧮</span>
            熱門計算機
          </h2>
          <p class="text-slate-600 mt-1">快速了解你的寵物年齡</p>
        </div>
        <a href="/tools/" class="text-amber-600 hover:text-amber-700 font-medium text-sm flex items-center gap-1">
          所有工具 →
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <a href="/tools/dog-age-calculator/" class="group block">
          <Card className="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-4xl">🐕</span>
              <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-bold rounded-full">熱門</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">狗狗年齡計算機</h3>
            <p class="text-sm text-slate-600">輸入年齡與體型，獲得人類年齡對照與生命階段建議</p>
          </Card>
        </a>

        <a href="/tools/cat-age-calculator/" class="group block">
          <Card className="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-4xl">🐱</span>
              <span class="px-2 py-1 bg-purple-100 text-purple-700 text-xs font-bold rounded-full">熱門</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">貓咪年齡計算機</h3>
            <p class="text-sm text-slate-600">了解你家貓咪的生命階段，獲得針對性的照護建議</p>
          </Card>
        </a>

        <a href="/tools/compare-aging/" class="group block">
          <Card className="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-4xl">⚖️</span>
              <span class="px-2 py-1 bg-teal-100 text-teal-700 text-xs font-bold rounded-full">新功能</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">年齡對照工具</h3>
            <p class="text-sm text-slate-600">同時比較狗狗和貓咪的人類年齡，快速了解誰更「老」</p>
          </Card>
        </a>
      </div>
    </section>

    <!-- Latest Articles Section -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
            <span class="text-2xl">📰</span>
            最新文章
          </h2>
          <p class="text-slate-600 mt-1">老化徵兆與早期發現</p>
        </div>
        <a href="/blog/" class="text-amber-600 hover:text-amber-700 font-medium text-sm flex items-center gap-1">
          查看全部 →
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <a href="/blog/dog-aging-signs/" class="group block">
          <Card className="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl">🐕</span>
              <span class="px-2 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">狗狗</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">狗狗老化徵兆完整指南</h3>
            <p class="text-sm text-slate-600 mb-3">7個不容忽視的老化徵兆與早期發現的重要性</p>
            <span class="text-xs text-slate-500">閱讀時間：約8分鐘</span>
          </Card>
        </a>

        <a href="/blog/cat-aging-signs/" class="group block">
          <Card className="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl">🐱</span>
              <span class="px-2 py-1 bg-purple-100 text-purple-700 text-xs font-bold rounded-full">貓咪</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">貓咪老化徵兆完整指南</h3>
            <p class="text-sm text-slate-600 mb-3">7個預示愛貓進入熟齡期的身體與行為變化</p>
            <span class="text-xs text-slate-500">閱讀時間：約8分鐘</span>
          </Card>
        </a>
      </div>
    </section>

    <!-- Senior Pet Resources Section -->
    <section class="mb-16">
      <div class="bg-slate-50 rounded-3xl p-8 border border-slate-200">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold text-slate-900 flex items-center justify-center gap-3">
            <span class="text-3xl">❤️</span>
            老年寵物照護資源
          </h2>
          <p class="text-slate-600 mt-2">幫助你的老朋友度過舒適的黃金歲月</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <a href="/blog/dog-aging-signs/" class="group bg-white rounded-2xl p-5 border border-slate-200 hover:shadow-md transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl">🐕</span>
              <span class="px-2 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">狗狗</span>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">狗狗老化徵兆</h3>
            <p class="text-sm text-slate-600">7個不容忽視的老化徵兆</p>
          </a>

          <a href="/blog/cat-aging-signs/" class="group bg-white rounded-2xl p-5 border border-slate-200 hover:shadow-md transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl">🐱</span>
              <span class="px-2 py-1 bg-purple-100 text-purple-700 text-xs font-bold rounded-full">貓咪</span>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">貓咪老化徵兆</h3>
            <p class="text-sm text-slate-600">7個預示熟齡期的變化</p>
          </a>

          <a href="/blog/pet-aging-guide/" class="group bg-white rounded-2xl p-5 border border-slate-200 hover:shadow-md transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl">📖</span>
              <span class="px-2 py-1 bg-slate-100 text-slate-700 text-xs font-bold rounded-full">總覽</span>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">老化完整指南</h3>
            <p class="text-sm text-slate-600">所有內容的導覽與連結</p>
          </a>
        </div>

        <div class="mt-6 text-center">
          <p class="text-sm text-slate-600 mb-4">需要立即評估寵物的健康狀況嗎？</p>
          <a
            href="/tools/symptom-checklist/"
            class="inline-flex items-center gap-2 px-6 py-3 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-xl transition-colors"
          >
            📋 使用症狀檢核表
          </a>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="mb-8">
      <div class="bg-white rounded-3xl p-8 border border-slate-200 text-center">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">開始了解你的寵物</h2>
        <p class="text-slate-600 max-w-xl mx-auto mb-6">
          從簡單的年齡計算開始，建立對你家寵物健康需求的更深理解。我們的工具和指南都免費使用，幫助你成為更好的寵物照護者。
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/tools/dog-age-calculator/"
            class="inline-flex items-center gap-2 px-6 py-3 bg-amber-600 hover:bg-amber-700 text-white font-semibold rounded-xl transition-colors"
          >
            🐕 狗狗計算機
          </a>
          <a
            href="/tools/cat-age-calculator/"
            class="inline-flex items-center gap-2 px-6 py-3 bg-slate-600 hover:bg-slate-700 text-white font-semibold rounded-xl transition-colors"
          >
            🐱 貓咪計算機
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>