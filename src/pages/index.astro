---
import Layout from '../layouts/Layout.astro';
---

<Layout title="首頁 - 利基型工具網站" description="為您提供最專業的線上實用工具集。">
  <section class="text-center py-16">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4">專業利基型工具</h1>
    <p class="text-lg text-gray-600 mb-8">快速、準確、免費，為解決您的生活問題而生。</p>
    <a href="/calculator" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold transition">
      立即使用計算機
    </a>
  </section>
</Layout>
