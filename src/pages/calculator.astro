---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSenseAd from '../components/AdSenseAd.astro';
import Card from '../components/Card.astro';
---

<BaseLayout title="專業數值計算機" description="高效、直覺的專業級數值運算工具。">
  <div class="max-w-xl mx-auto mt-16 px-4">
    <Card className="shadow-[0_8px_30px_rgb(0,0,0,0.04)] border-slate-100">
      <header class="mb-8">
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">計算機</h1>
        <p class="text-slate-500 text-sm mt-1">極簡高效的運算解決方案</p>
      </header>
      
      <div class="space-y-6">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1">
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">數值 A</label>
            <input type="number" id="valA" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-mono" placeholder="0">
          </div>
          <div class="space-y-1">
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">數值 B</label>
            <input type="number" id="valB" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all font-mono" placeholder="0">
          </div>
        </div>

        <button id="calcBtn" class="w-full bg-slate-900 text-white py-3 rounded-lg font-semibold hover:bg-slate-800 active:scale-[0.99] transition-all shadow-lg shadow-slate-200">
          計算結果
        </button>

        <div id="resultWrapper" class="mt-8 p-6 bg-slate-50 rounded-xl border border-slate-100 text-center hidden">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">計算結果</p>
          <div id="result" class="text-3xl font-bold text-slate-900 font-mono">0</div>
        </div>
      </div>
    </Card>

    <div class="mt-8">
      <AdSenseAd format="rectangle" />
    </div>
  </div>

  <script>
    const btn = document.getElementById('calcBtn');
    const valA = document.getElementById('valA') as HTMLInputElement;
    const valB = document.getElementById('valB') as HTMLInputElement;
    const resultWrapper = document.getElementById('resultWrapper');
    const result = document.getElementById('result');

    btn?.addEventListener('click', async () => {
      const a = parseFloat(valA.value);
      const b = parseFloat(valB.value);
      if (isNaN(a) || isNaN(b)) return;

      btn.innerText = "計算中...";
      btn.classList.add('opacity-70');

      const response = await fetch('/api/calculate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ a, b }),
      });
      
      const data = await response.json();
      
      if (result && resultWrapper) {
        result.textContent = data.result;
        resultWrapper.classList.remove('hidden');
        btn.innerText = "計算結果";
        btn.classList.remove('opacity-70');
      }
    });
  </script>
</BaseLayout>
