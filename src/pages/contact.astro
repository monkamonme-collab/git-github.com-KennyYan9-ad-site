---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: '首頁', url: '/' },
  { label: '聯絡我們', url: '/contact/' }
];
---

<BaseLayout
  title="聯絡我們 - Pet Aging Hub"
  description="如有任何關於寵物老化或健康問題的疑問，歡迎聯絡 Pet Aging Hub。我們會在 2-3 個工作日內回覆您的來信。"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-2xl mx-auto">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-extrabold text-slate-900 mb-4">聯絡我們</h1>
      <p class="text-lg text-slate-600">
        有任何問題或建議？我們很樂意聽到您的聲音。
      </p>
    </header>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <div class="text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <span class="text-2xl">📧</span>
        </div>
        <h3 class="font-bold text-slate-900 mb-1">電子郵件</h3>
        <p class="text-sm text-slate-600">
          <a href="mailto:contact@petaginghub.com" class="text-blue-600 hover:text-blue-700">
            monkamonme@gmail.com
          </a>
        </p>
      </div>

      <div class="text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <span class="text-2xl">⏱️</span>
        </div>
        <h3 class="font-bold text-slate-900 mb-1">回覆時間</h3>
        <p class="text-sm text-slate-600">2-3 個工作日</p>
      </div>

      <div class="text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <span class="text-2xl">🌐</span>
        </div>
        <h3 class="font-bold text-slate-900 mb-1">位置</h3>
        <p class="text-sm text-slate-600">線上資源平台</p>
      </div>
    </div>

    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900 mb-6">傳送訊息</h2>

      <form id="contact-form" class="space-y-6">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 mb-2">
            您的姓名 <span class="text-slate-400">(選填)</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-colors"
            placeholder="王小明"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-2">
            電子郵件 <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-colors"
            placeholder="your.email@example.com"
          />
          <p class="text-xs text-slate-500 mt-1">用於回覆您的訊息</p>
        </div>

        <div>
          <label for="subject" class="block text-sm font-medium text-slate-700 mb-2">
            訊息類型
          </label>
          <select
            id="subject"
            name="subject"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-colors"
          >
            <option value="general">一般詢問</option>
            <option value="content">內容建議或勘誤</option>
            <option value="technical">網站技術問題</option>
            <option value="feedback">網站反饋</option>
            <option value="partnership">合作洽談</option>
            <option value="other">其他</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-slate-700 mb-2">
            訊息內容 <span class="text-red-500">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-colors resize-none"
            placeholder="請輸入您的訊息..."
          ></textarea>
        </div>

        <div class="bg-slate-50 rounded-xl p-4 border border-slate-200">
          <p class="text-sm text-slate-600 leading-relaxed">
            <strong>重要提醒：</strong>本網站不提供獸醫諮詢服務。如果您有寵物健康方面的緊急問題，請直接聯繫您所在地的獸醫診所。我們無法回覆個別寵物的健康問題。
          </p>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full py-4 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-colors shadow-md"
        >
          傳送訊息
        </button>
      </form>

      <div id="success-message" class="hidden text-center py-8">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-3xl">✅</span>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">訊息已傳送</h3>
        <p class="text-slate-600">
          感謝您的來信！我們會在 2-3 個工作日內回覆您。
        </p>
      </div>

      <div id="error-message" class="hidden text-center py-8">
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-3xl">❌</span>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">傳送失敗</h3>
        <p class="text-slate-600 mb-4">
          抱歉，訊息傳送失敗。請稍後再試，或直接寄送電子郵件至：
        </p>
        <a href="mailto:contact@petaginghub.com" class="text-blue-600 hover:text-blue-700 font-medium">
          monkamonme@gmail.com
        </a>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-12">
      <h2 class="text-xl font-bold text-slate-900 mb-6">常見問題</h2>

      <div class="space-y-4">
        <div class="bg-white rounded-2xl p-6 border border-slate-200">
          <h3 class="font-bold text-slate-900 mb-2">我可以請你們幫我診斷我的寵物的健康問題嗎？</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            很抱歉，我們無法提供個人化的獸醫建議。本網站的所有內容僅供教育參考，不能替代專業獸醫的診斷。如果您的寵物有任何健康問題，請預約當地的獸醫門診。我們的症狀檢核表可以幫助您判斷是否需要緊急就醫。
          </p>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200">
          <h3 class="font-bold text-slate-900 mb-2">我可以轉載或引用你們網站的內容嗎？</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            未經書面許可，不得轉載、複製或大規模引用本網站內容用於商業目的。個人用途和教育目的的少量引用需附上本網站連結。如有合作需求，請透過本頁面的聯絡表單與我們洽談。
          </p>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200">
          <h3 class="font-bold text-slate-900 mb-2">你們是獸醫嗎？</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            我們不是獸醫診所，編輯團隊由內容創作者和研究人員組成，致力於整理和傳播準確的寵物健康資訊。所有內容都會參考公開的獸醫學研究和數據。我們鼓勵用戶在有任何健康疑慮時諮詢專業獸醫。
          </p>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200">
          <h3 class="font-bold text-slate-900 mb-2">如何建議新文章主題或回報錯誤？</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            我們非常歡迎讀者的建議和反饋！請使用上面的聯絡表單，選擇「內容建議或勘誤」作為訊息類型，告訴我們您希望看到的內容或您發現的任何錯誤。我們會認真考慮所有建議。
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Validate
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const message = (document.getElementById('message') as HTMLTextAreaElement).value;

      if (!email || !message) {
        alert('請填寫必填欄位');
        return;
      }

      // Simple email validation
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        alert('請輸入有效的電子郵件地址');
        return;
      }

      // Simulate form submission
      submitBtn.disabled = true;
      submitBtn.textContent = '傳送中...';

      // In a real implementation, this would send to a backend or email service
      // For now, we'll simulate a successful submission after a brief delay
      setTimeout(() => {
        form.classList.add('hidden');
        if (successMessage) successMessage.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = '傳送訊息';
      }, 1500);
    });
  </script>
</BaseLayout>
