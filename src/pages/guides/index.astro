---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro"; // 假設Card組件存在且可用
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');
---
<BaseLayout title="專業深度指南 | 助您掌握行業知識與策略" description="探索我們精心編撰的專業指南，涵蓋最新趨勢、實用教學與深度分析，助您提升專業技能，驅動業務成長。">
  <img src="https://source.unsplash.com/featured/1200x400?guide" alt="Guide banner" class="w-full mb-8 rounded-lg"/>
  <div class="max-w-4xl mx-auto py-12"><h1>專家指南</h1></div>
</BaseLayout>
