---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';
import Card from '../../components/Card.astro';
---

<BaseLayout title="狗狗人類年齡換算計算機 | 專業寵物年齡對照表" description="一鍵計算狗狗等於人類幾歲！專業寵物年齡換算器，提供體型差異對照表與老化照護建議，幫助您更了解愛犬的生命階段。">
  <div class="max-w-3xl mx-auto mt-12 px-6">
    <Card className="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-6">狗狗人類年齡換算計算機</h1>
      <div class="space-y-6">
        <div class="grid md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700">狗狗目前歲數</label>
            <input type="number" id="dogAge" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="輸入歲數">
          </div>
          <div class="space-y-2">
            <label class="block text-sm font-medium text-slate-700">狗狗體型</label>
            <select id="dogSize" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
              <option value="small">小型犬</option>
              <option value="medium">中型犬</option>
              <option value="large">大型犬</option>
            </select>
          </div>
        </div>
        <button id="calcBtn" class="w-full bg-slate-900 text-white py-4 rounded-xl font-bold hover:bg-slate-800 transition-all">計算對應人類歲數</button>
        <div id="result" class="p-6 bg-blue-50 rounded-2xl text-center text-xl font-bold text-blue-900 hidden"></div>
      </div>
    </Card>

    <AdSenseAd format="rectangle" />

    <article class="prose prose-slate max-w-none mt-12">
      <h2 id="how-to-calculate">為什麼狗狗年齡不能簡單乘以 7？</h2>
      <p>許多人認為「狗一歲等於人七歲」，這其實是非常粗略的估算法。狗狗在生命的第一年發育最快，對應人類約 15 歲的青少年階段。隨著體型不同，老化速度也會有顯著差異：</p>
      
      <h3 id="age-table">狗狗人類年齡對照表 (簡易版)</h3>
      <table class="w-full border-collapse">
        <thead class="bg-slate-100"><tr><th class="p-3 border">狗狗年齡</th><th class="p-3 border">人類對照歲數</th></tr></thead>
        <tbody>
          <tr><td class="p-3 border">1 歲</td><td class="p-3 border">15 歲 (青年)</td></tr>
          <tr><td class="p-3 border">5 歲</td><td class="p-3 border">36 歲 (壯年)</td></tr>
          <tr><td class="p-3 border">10 歲</td><td class="p-3 border">56 歲 (高齡)</td></tr>
        </tbody>
      </table>

      <h2 id="faq">常見問題 (FAQ)</h2>
      <div class="space-y-4">
        <div><strong>Q: 大型犬和小型犬哪個壽命比較長？</strong><br>A: 小型犬的平均壽命通常高於大型犬，大型犬因生理負擔較重，老化速度往往更快。</div>
      </div>
    </article>

    <nav class="mt-12 py-8 border-t border-slate-200 flex justify-between items-center">
      <a href="/" class="text-slate-500 hover:text-slate-900">← 返回首頁</a>
      <a href="/tools/cat-age-calculator" class="text-blue-600 font-bold hover:text-blue-800">下一站：貓咪年齡計算 →</a>
    </nav>
  </div>

  <script>
    const btn = document.getElementById('calcBtn');
    const ageInput = document.getElementById('dogAge') as HTMLInputElement;
    const sizeInput = document.getElementById('dogSize') as HTMLInputElement;
    const result = document.getElementById('result');

    btn?.addEventListener('click', async () => {
      const age = parseFloat(ageInput.value);
      const res = await fetch('/api/calculate-age', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'dog', age, size: sizeInput.value }),
      });
      const data = await res.json();
      if (result) {
        result.textContent = `您的愛犬約等於人類 ${data.result} 歲`;
        result.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
