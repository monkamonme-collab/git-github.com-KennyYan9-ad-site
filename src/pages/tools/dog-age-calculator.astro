  <script>
    const ageInput = document.getElementById('dogAge') as HTMLInputElement;
    const sizeInput = document.getElementById('dogSize') as HTMLSelectElement;
    const resultDisplay = document.getElementById('result');
    const lifeStageText = document.getElementById('resultText');

    const calculateHumanAge = (age: number, size: string): { humanAge: number; stage: string; stageText: string } => {
      if (age <= 0) return { humanAge: 0, stage: 'puppy', stageText: 'å¹¼å¹´éæ®µ' };
      if (age === 1) {
        const base = size === 'giant' ? 12 : 15;
        return { humanAge: base, stage: 'puppy', stageText: 'éå°å¹´éæ®µ' };
      }
      if (age === 2) {
        const base = size === 'giant' ? 22 : 24;
        const stage = size === 'giant' ? 'young' : 'adult';
        const stageText = size === 'giant' ? 'éå°å¹´è³æå¹´åæ' : 'æå¹´åæ';
        return { humanAge: base, stage, stageText };
      }

      let increment = 4;
      if (size === 'medium') increment = 5;
      else if (size === 'large') increment = 6;
      else if (size === 'giant') increment = 7;

      const humanAge = 24 + (age - 2) * increment;

      let stage = 'adult';
      let stageText = 'æå¹´æ';
      if (age >= 10) { stage = 'geriatric'; stageText = 'èå¹´æ'; }
      else if (age >= 7) { stage = 'senior'; stageText = 'çé½¡æ'; }
      else if (age >= 3) { stage = 'adult'; stageText = 'æå¹´æ'; }
      else { stage = 'young'; stageText = 'éå°å¹´è³æå¹´åæ'; }

      return { humanAge, stage, stageText };
    };

    const update = () => {
      const age = parseInt(ageInput.value) || 0;
      const size = sizeInput.value;
      const { humanAge, stageText } = calculateHumanAge(age, size);

      if (resultDisplay) resultDisplay.textContent = `${humanAge} æ­²`;
      if (lifeStageText) lifeStageText.textContent = `å·²é²å¥ ${stageText}`;
    };

    ageInput.addEventListener('input', update);
    sizeInput.addEventListener('change', update);
    update();
  </script>
