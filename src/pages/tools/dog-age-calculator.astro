---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';
import Card from '../../components/Card.astro';

const title = "狗狗人類年齡換算計算機 | 精準掌握愛犬生命階段";
const description = "想知道狗狗等於人類幾歲嗎？使用 AVMA 獸醫標準演算法，一鍵精算狗狗年齡。包含不同體型老化差異對照表、各生命階段專業照護指南。";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto mt-12 px-6">
    <Card className="mb-12">
      <h1 class="text-3xl font-bold text-slate-900 mb-6">{title}</h1>
      <div class="space-y-6">
        <!-- Input section remains as established -->
        <div class="grid md:grid-cols-2 gap-6">
          <input type="number" id="dogAge" class="w-full px-4 py-3 bg-slate-50 border rounded-lg" placeholder="狗狗歲數">
          <select id="dogSize" class="w-full px-4 py-3 bg-slate-50 border rounded-lg">
            <option value="small">小型 (<10kg)</option>
            <option value="medium">中型 (10-25kg)</option>
            <option value="large">大型 (25-40kg)</option>
            <option value="giant">巨型 (>40kg)</option>
          </select>
        </div>
        <button id="calcBtn" class="w-full bg-blue-600 text-white py-4 rounded-xl font-bold hover:bg-blue-700 transition">開始換算</button>
        <div id="result" class="p-6 bg-blue-50 rounded-2xl text-center text-xl font-bold text-blue-900 hidden"></div>
      </div>
    </Card>

    <AdSenseAd format="rectangle" />

    <article class="prose prose-slate max-w-none mt-12">
      <h2>為什麼狗狗年齡換算不能只乘以 7？</h2>
      <p>過去許多飼主習慣將狗的一歲視為人類七歲，但這是一個過時的觀念。根據美國獸醫師協會 (AVMA) 的研究，狗狗在生命的第一年發育最快，對應人類約 15 歲的成長水平。不同體型的犬種，其老化速度存在巨大差異，小型犬通常比大型犬長壽。</p>

      <h3>狗狗各生命階段照護指南</h3>
      <ul>
        <li><strong>幼犬期 (0-2歲)</strong>：此階段細胞代謝極快，是疫苗接種與行為訓練的黃金期。</li>
        <li><strong>成犬期 (3-7歲)</strong>：維持規律運動與體重管理是預防慢性病的關鍵。</li>
        <li><strong>高齡期 (8歲以上)</strong>：建議每年進行兩次完整的血檢與健檢，特別是針對關節炎與腎臟功能。</li>
      </ul>

      <h2 id="faq">常見問題 (FAQ)</h2>
      <dl>
        <dt class="font-bold">Q: 大型犬和小型犬哪個壽命比較長？</dt>
        <dd class="mb-4">A: 普遍來說，小型犬的平均壽命長於大型犬，這與遺傳基因與生理負擔有關。</dd>
        <dt class="font-bold">Q: 何時應視為高齡犬？</dt>
        <dd class="mb-4">A: 根據大多數獸醫機構建議，狗狗進入 8 歲後即可視為邁入高齡階段。</dd>
      </dl>
    </article>
  </div>
  
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "狗狗人類年齡換算計算機",
    "applicationCategory": "Utilities",
    "description": "AVMA標準計算狗狗對應人類歲數。"
  }
  </script>
</BaseLayout>
