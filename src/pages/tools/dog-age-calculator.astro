---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "狗狗年齡計算機 | AVMA 標準科算人類年齡";
const description = "使用美國獸醫師協會 (AVMA) 標準公式，精準計算狗狗對應人類年齡。支援小型犬、中型犬、大型犬、巨型犬體型換算。";
const canonicalPath = "/tools/dog-age-calculator";
const canonicalURL = new URL(canonicalPath, "https://www.petaginghub.com/");

const breadcrumbs = [
  { label: '工具集', url: '/tools' },
  { label: '狗狗年齡計算機', url: canonicalPath }
];

const lifeStages = [
  { range: '0-1 歲', human: '嬰兒期至青少年', stage: 'puppy' },
  { range: '1-3 歲', human: '青少年至成年初期', stage: 'young' },
  { range: '3-7 歲', human: '成年期', stage: 'adult' },
  { range: '7-10 歲', human: '熟齡期', stage: 'senior' },
  { range: '10+ 歲', human: '老年期', stage: 'geriatric' }
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>

  <!-- Hero Section -->
  <header class="max-w-4xl mx-auto px-6 pt-10 pb-8">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-4xl">🐶</span>
      <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">AVMA 標準</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
      狗狗年齡計算機
    </h1>
    <p class="text-lg text-slate-600 leading-relaxed max-w-2xl">
      想知道您的愛犬等於人類幾歲嗎？本工具採用美國獸醫師協會 (AVMA) 認可的科學公式，根據狗狗體型與年齡，精準換算對應的人類生命階段。
    </p>
  </header>

  <!-- Calculator Card -->
  <section class="max-w-4xl mx-auto px-6 mb-10">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="space-y-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">狗狗目前歲數</label>
            <input
              type="number"
              id="dogAge"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
              value="3"
              min="0"
              max="30"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">狗狗體型</label>
            <select
              id="dogSize"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
            >
              <option value="small">小型犬 (體重低於 10kg)</option>
              <option value="medium">中型犬 (10–25kg)</option>
              <option value="large">大型犬 (25–40kg)</option>
              <option value="giant">巨型犬 (超過 40kg)</option>
            </select>
          </div>
        </div>

        <div class="flex flex-col items-center justify-center bg-gradient-to-b from-blue-50 to-slate-50 rounded-xl p-6">
          <p class="text-sm text-slate-500 mb-2">對應人類年齡</p>
          <p class="text-5xl font-black text-blue-600 mb-3" id="result">32 歲</p>
          <p class="text-sm text-slate-500 text-center" id="lifeStageText">已進入成年期</p>
          <div class="w-full mt-4">
            <div class="w-full bg-slate-100 rounded-full h-4 relative overflow-hidden border border-slate-200">
              <div id="progressFill" class="h-full transition-all duration-700 bg-blue-600 rounded-full" style="width: 30%"></div>
              <div class="absolute inset-0 flex justify-between px-2 text-[9px] text-slate-400 font-medium items-center uppercase tracking-wider">
                <span>幼年</span><span>成年</span><span>熟齡</span><span>老年</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Signal -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 flex items-start gap-4">
      <div class="text-blue-600 mt-0.5">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-slate-800">本計算機採用 AVMA 標準公式</p>
        <p class="text-sm text-slate-500 mt-0.5">
          美國獸醫師協會 (American Veterinary Medical Association) 是全球最具權威的獸醫專業機構，其狗狗年齡換算標準已被全球獸醫師廣泛採用。
        </p>
      </div>
    </div>
  </section>

  <!-- SEO Introduction -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">為什麼狗狗年齡不能直接乘以 7？</h2>
    <div class="prose prose-slate prose-headings:text-slate-900 prose-p:text-slate-600 prose-li:text-slate-600 max-w-none space-y-4">
      <p>
        許多人在童年時就聽過「狗狗 1 年等於人類 7 年」的說法，但這個算法過度簡化，忽略了幾個重要的生物學事實。狗狗在生命第一年的成長速度遠比人類快，一隻 1 歲的狗狗在生理發育上已接近人類的 15 歲。
      </p>
      <p>
        此外，狗狗的體型大小也會顯著影響老化速度。大型犬通常比小型犬衰老得更快，一隻 5 歲的大型犬可能已經進入熟齡期，而同齡的小型犬可能仍處於成年壯年期。這就是為什麼本計算機會根據狗狗的體型分類提供不同的換算結果。
      </p>
      <p>
        理解狗狗的真實年齡有助於您提供更適切的照護。不同生命階段的狗狗有不同的營養需求、運動量需求和健康監測重點。及早調整照護方式，可以幫助您的愛犬健康地度過每一個生命階段。
      </p>
    </div>
  </section>

  <!-- Methodology Section -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">計算方法說明</h2>
    <div class="bg-white border border-slate-200 rounded-xl p-6 space-y-4">
      <p class="text-slate-600">
        本計算機採用美國獸醫師協會 (AVMA) 認可的分段線性公式，考慮了狗狗生命早期的快速發育，以及不同體型間的老化差異。
      </p>

      <div class="bg-slate-50 rounded-lg p-4 font-mono text-sm">
        <p class="font-semibold text-slate-700 mb-2">計算公式：</p>
        <p class="text-slate-600">第一年 = 15 歲（小型/中型/大型犬）/ 12 歲（巨型犬）</p>
        <p class="text-slate-600">第二年 = +9 歲（小型/中型/大型犬）/ +10 歲（巨型犬）</p>
        <p class="text-slate-600">第三年起每年 = +4-7 歲（依體型）</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 text-slate-700 font-semibold">體型</th>
              <th class="text-right py-2 text-slate-700 font-semibold">2歲時人類年齡</th>
              <th class="text-right py-2 text-slate-700 font-semibold">每年遞增</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100">
              <td class="py-2">小型犬 (&lt;10kg)</td>
              <td class="text-right py-2">24 歲</td>
              <td class="text-right py-2">+4 歲/年</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-2">中型犬 (10–25kg)</td>
              <td class="text-right py-2">24 歲</td>
              <td class="text-right py-2">+5 歲/年</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-2">大型犬 (25–40kg)</td>
              <td class="text-right py-2">24 歲</td>
              <td class="text-right py-2">+6 歲/年</td>
            </tr>
            <tr>
              <td class="py-2">巨型犬 (&gt;40kg)</td>
              <td class="text-right py-2">22 歲</td>
              <td class="text-right py-2">+7 歲/年</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-xs text-slate-500">
        資料來源：American Veterinary Medical Association (AVMA). Canine Life Stage Guidelines. JAVMA, 2012.
      </p>
    </div>
  </section>

  <!-- Life Stages Reference -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">狗狗生命階段與照護重點</h2>
    <div class="grid gap-4">
      {lifeStages.map((stage) => (
        <div class="bg-white border border-slate-200 rounded-xl p-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class={`inline-block text-xs font-bold px-2 py-0.5 rounded mb-2 ${
                stage.stage === 'puppy' ? 'bg-pink-100 text-pink-700' :
                stage.stage === 'young' ? 'bg-orange-100 text-orange-700' :
                stage.stage === 'adult' ? 'bg-green-100 text-green-700' :
                stage.stage === 'senior' ? 'bg-yellow-100 text-yellow-700' :
                'bg-red-100 text-red-700'
              }`}>
                {stage.range}
              </span>
              <p class="text-slate-600">{stage.human}</p>
            </div>
            <div class={`w-3 h-3 rounded-full mt-1.5 ${
              stage.stage === 'puppy' ? 'bg-pink-400' :
              stage.stage === 'young' ? 'bg-orange-400' :
              stage.stage === 'adult' ? 'bg-green-400' :
              stage.stage === 'senior' ? 'bg-yellow-400' :
              'bg-red-400'
            }`}></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">常見問題</h2>
    <div class="space-y-4">
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">
          為什麼大型犬比小型犬老得快？
        </summary>
        <div class="px-5 pb-5 text-slate-600">
          大型犬的新陳代謝負擔更重，身體器官需要支撐更大的體重，因此老化速度普遍較快。一隻 7 歲的大型犬可能已進入老年期，而同齡的小型犬可能仍處於壯年。這就是為什麼體型是準確換算的關鍵因素。
        </div>
      </details>

      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">
          狗年和人年的對照表是怎麼來的？
        </summary>
        <div class="px-5 pb-5 text-slate-600">
          這個對照表基於多項狗狗生長發育研究，包括牙齒發育模式、青春期到成年期的過渡、以及老年疾病的發病率等因素。AVMA 的指南是綜合了這些研究後的共識建議，而非單一研究結論。
        </div>
      </details>

      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">
          如何判斷我的狗狗是不是進入老年期了？
        </summary>
        <div class="px-5 pb-5 text-slate-600">
          除了年齡數字，老年期的狗狗通常會出現以下徵兆：活動量下降、睡眠時間增加、反應變慢、毛色變淺、聽力或視力減退、牙齒問題等。建議 7 歲以上的狗狗每半年進行一次健康檢查。
        </div>
      </details>

      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">
          純種犬和混種犬的壽命有差異嗎？
        </summary>
        <div class="px-5 pb-5 text-slate-600">
          一般而言，混種犬因為基因多樣性較高，遺傳疾病的發病率較低，壽命往往比純種犬稍長。但無論純種或混種，適當的飲食、運動和定期健康檢查都是延長壽命的關鍵因素。
        </div>
      </details>
    </div>
  </section>

  <!-- References Section -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">參考文獻</h2>
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 space-y-3 text-sm text-slate-600">
      <p>1. American Veterinary Medical Association. <em>Canine Life Stage Guidelines</em>. Journal of the American Veterinary Medical Association, 2012; 240(5): 552-558.</p>
      <p>2. Patronek GJ, Waters DJ, Glickman LT. Comparative longevity of pet dogs and humans: Implications for gerontology research. <em>The Journals of Gerontology</em>. 1997; 52(3): B171-B178.</p>
      <p>3. Proschowsky HF, Rugbjerg H, Ersbøll AK. Mortality of purebred and mixedbred dogs in Denmark. <em>Preventive Veterinary Medicine</em>. 2003; 58(1-2): 63-74.</p>
      <p>4. AVMA. <em>Senior Pet Care Guidelines</em>. American Veterinary Medical Association, 2012.</p>
    </div>
  </section>

  <!-- Related Calculators -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">相關計算機</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <a href="/tools/cat-age-calculator/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">🐱</span>
          <span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">貓咪年齡計算機</span>
        </div>
        <p class="text-sm text-slate-500">採用 AAHA/AVMA 標準，計算愛貓的人類年齡對應。</p>
      </a>
    </div>
  </section>

  <!-- Related Articles -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">延伸閱讀</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <a href="/blog/dog-aging-signs/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-lg">📖</span>
          <span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">狗狗老化徵兆：7個預示愛犬進入熟齡期的變化</span>
        </div>
        <p class="text-sm text-slate-500">從活動量下降到毛色變化，解析 7 個狗狗常見老化徵兆，及早發現、及早照護。</p>
      </a>
      <a href="/blog/senior-pet-health-guide/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-lg">🏥</span>
          <span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">老年犬貓的健康照護指南</span>
        </div>
        <p class="text-sm text-slate-500">從營養調整到定期檢查，了解老年犬常見健康風險與科學照護流程。</p>
      </a>
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="border-t border-slate-200 pt-8">
      <p class="text-xs text-slate-500 leading-relaxed">
        <strong>免責聲明：</strong>本工具的計算結果基於美國獸醫師協會 (AVMA) 發布的普遍性指導原則，結果僅供參考，不構成任何獸醫診斷或治療建議。每隻狗狗的健康狀況都是獨特的，若您對愛犬的健康有任何疑慮，請諮詢執業獸醫師。
      </p>
    </div>
  </section>

  <!-- Navigation -->
  <nav class="max-w-4xl mx-auto px-6 pb-12 flex justify-between items-center text-sm">
    <span class="text-slate-400"></span>
    <a href="/tools/" class="text-blue-600 hover:text-blue-700 font-medium">← 所有工具</a>
    <a href="/tools/cat-age-calculator/" class="text-blue-600 hover:text-blue-700 font-medium">貓咪年齡計算機 →</a>
  </nav>

  <!-- JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "狗狗年齡計算機",
    "description": "採用 AVMA 標準公式，根據狗狗體型與年齡，精準換算對應的人類年齡。",
    "url": canonicalURL,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  })} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "為什麼大型犬比小型犬老得快？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "大型犬的新陳代謝負擔更重，身體器官需要支撐更大的體重，因此老化速度普遍較快。一隻 7 歲的大型犬可能已進入老年期，而同齡的小型犬可能仍處於壯年。"
        }
      },
      {
        "@type": "Question",
        "name": "狗年和人年的對照表是怎麼來的？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "這個對照表基於多項狗狗生長發育研究，包括牙齒發育模式、青春期到成年期的過渡、以及老年疾病的發病率等因素。AVMA 的指南是綜合了這些研究後的共識建議。"
        }
      },
      {
        "@type": "Question",
        "name": "如何判斷狗狗是不是進入老年期了？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "除了年齡數字，老年期的狗狗通常會出現活動量下降、睡眠時間增加、反應變慢、毛色變淺、聽力或視力減退等徵兆。建議 7 歲以上的狗狗每半年進行一次健康檢查。"
        }
      },
      {
        "@type": "Question",
        "name": "純種犬和混種犬的壽命有差異嗎？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "一般而言，混種犬因為基因多樣性較高，遺傳疾病的發病率較低，壽命往往比純種犬稍長。但無論純種或混種，適當的飲食、運動和定期健康檢查都是延長壽命的關鍵因素。"
        }
      }
    ]
  })} />

  <script>
    const ageInput = document.getElementById('dogAge') as HTMLInputElement;
    const sizeInput = document.getElementById('dogSize') as HTMLSelectElement;
    const resultDisplay = document.getElementById('result');
    const lifeStageText = document.getElementById('lifeStageText');
    const progressFill = document.getElementById('progressFill');

    const calculateHumanAge = (age: number, size: string): { humanAge: number; stage: string; stageText: string; progress: number } => {
      if (age <= 0) return { humanAge: 0, stage: 'puppy', stageText: '幼年階段', progress: 5 };
      if (age === 1) {
        const base = size === 'giant' ? 12 : 15;
        return { humanAge: base, stage: 'puppy', stageText: '青少年階段', progress: 10 };
      }
      if (age === 2) {
        const base = size === 'giant' ? 22 : 24;
        return { humanAge: base, stage: 'young', stageText: '成年初期', progress: 20 };
      }

      let increment = 4;
      if (size === 'medium') increment = 5;
      else if (size === 'large') increment = 6;
      else if (size === 'giant') increment = 7;

      const humanAge = 24 + (age - 2) * increment;

      let stage = 'adult';
      let stageText = '成年期';
      let progress = 30;
      if (age >= 10) { stage = 'geriatric'; stageText = '老年期'; progress = Math.min(90 + (age - 10) * 3, 100); }
      else if (age >= 7) { stage = 'senior'; stageText = '熟齡期'; progress = 60 + (age - 7) * 10; }
      else { progress = 25 + (age - 2) * 5; }

      return { humanAge, stage, stageText, progress };
    };

    const update = () => {
      const age = parseInt(ageInput.value) || 0;
      const size = sizeInput.value;
      const { humanAge, stageText, progress } = calculateHumanAge(age, size);

      if (resultDisplay) resultDisplay.textContent = `${humanAge} 歲`;
      if (lifeStageText) lifeStageText.textContent = `已進入 ${stageText}`;
      if (progressFill) progressFill.style.width = `${progress}%`;
    };

    ageInput.addEventListener('input', update);
    sizeInput.addEventListener('change', update);
    update();
  </script>
</BaseLayout>
