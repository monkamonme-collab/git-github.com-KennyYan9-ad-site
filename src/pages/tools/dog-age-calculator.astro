import SEO from '../components/SEO.astro';

const title = "狗狗人類年齡換算計算機 | AVMA 專業標準";
const description = "使用專業獸醫標準，一鍵精算狗狗對應人類年齡。直觀介面，精準掌握愛犬生命階段與照護重點。";
---

<BaseLayout>
  <SEO slot="head" title={title} description={description} canonicalPath={Astro.url.pathname} />
  <main class="max-w-2xl mx-auto px-6 py-12">
    <header class="text-center mb-10">
      <img src="/assets/tools/dog-age.webp" alt={title} class="mx-auto w-32 h-32 object-cover rounded-3xl shadow-lg mb-6" />
      <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-4">狗狗年齡計算機</h1>
      <p class="text-slate-600">精準換算愛犬生命階段，提供專業飼養建議。</p>
    </header>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-8 md:p-10">
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">狗狗目前歲數</label>
          <input type="number" id="dogAge" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-100 outline-none transition" value="1" min="0" max="30">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">狗狗體型</label>
          <select id="dogSize" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-blue-100 outline-none transition">
            <option value="small">小型犬 (<10kg)</option>
            <option value="medium">中型犬 (10-25kg)</option>
            <option value="large">大型犬 (25-40kg)</option>
            <option value="giant">巨型犬 (>40kg)</option>
          </select>
        </div>
        
        <div id="resultBox" class="bg-blue-600 rounded-2xl p-6 text-center text-white shadow-lg hidden">
          <p class="text-sm opacity-80 mb-1">對應人類年齡約為</p>
          <p class="text-5xl font-black" id="result"></p>
        </div>
      </div>
    </div>

    <!-- 廣告佔位 -->
    <div class="my-10 bg-slate-100 border border-slate-200 rounded-2xl min-h-[100px] flex items-center justify-center text-slate-400">
      <p class="text-sm font-medium">AdSense Placeholder</p>
    </div>

    <article class="prose prose-slate max-w-none mt-12">
      <h2>為什麼需要換算狗狗年齡？</h2>
      <p>狗狗的成長曲線並非線性，理解其生理階段對於精準照護至關重要。本工具採用美國獸醫師協會 (AVMA) 標準演算法，協助您科學化管理愛犬健康。</p>
    </article>
  </main>

  <script>
    import { calculateDogAge } from '../../utils/calculators';
    
    const ageInput = document.getElementById('dogAge') as HTMLInputElement;
    const sizeInput = document.getElementById('dogSize') as HTMLSelectElement;
    const resultBox = document.getElementById('resultBox');
    const resultDisplay = document.getElementById('result');

    const update = () => {
      const age = parseInt(ageInput.value);
      const size = sizeInput.value as any;
      const humanAge = calculateDogAge(age, size);
      
      if (resultDisplay && resultBox) {
        resultDisplay.textContent = `${humanAge} 歲`;
        resultBox.classList.remove('hidden');
      }
    };

    [ageInput, sizeInput].forEach(el => el.addEventListener('input', update));
    update();
  </script>
</BaseLayout>
