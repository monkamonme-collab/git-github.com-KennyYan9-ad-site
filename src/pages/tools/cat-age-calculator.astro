---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';
import Card from '../../components/Card.astro';
---

<BaseLayout title="貓咪人類年齡換算計算機 | 專業貓齡對照表" description="想知道您的貓咪等於人類幾歲嗎？專業貓齡換算器，提供貓咪各階段生命週期對照表與老貓照護指南，幫助您給予愛貓更好的照顧。">
  <div class="max-w-3xl mx-auto mt-12 px-6">
    <Card className="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-6">貓咪人類年齡換算計算機</h1>
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">貓咪目前歲數</label>
          <input type="number" id="catAge" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="輸入歲數">
        </div>
        <button id="calcBtn" class="w-full bg-slate-900 text-white py-4 rounded-xl font-bold hover:bg-slate-800 transition-all">計算換算年齡</button>
        <div id="result" class="p-6 bg-blue-50 rounded-2xl text-center text-xl font-bold text-blue-900 hidden"></div>
      </div>
    </Card>

    <AdSenseAd format="rectangle" />

    <article class="prose prose-slate max-w-none mt-12">
      <h2 id="why-calculate">為什麼要計算貓咪的換算年齡？</h2>
      <p>貓咪的成長速度遠快於人類。了解愛貓處於生命中的哪個階段（幼貓、成貓、還是老貓），對於預防醫學與飲食調整至關重要。一般來說，貓咪前兩年成長最快，此後老化速度趨於平緩。</p>
      
      <h3 id="age-table">貓咪人類年齡對照表</h3>
      <table class="w-full border-collapse">
        <thead class="bg-slate-100"><tr><th class="p-3 border">貓咪歲數</th><th class="p-3 border">人類對照歲數</th></tr></thead>
        <tbody>
          <tr><td class="p-3 border">1 歲</td><td class="p-3 border">19 歲 (成年)</td></tr>
          <tr><td class="p-3 border">5 歲</td><td class="p-3 border">36 歲 (壯年)</td></tr>
          <tr><td class="p-3 border">10 歲</td><td class="p-3 border">56 歲 (高齡)</td></tr>
        </tbody>
      </table>

      <h2 id="faq">常見問題 (FAQ)</h2>
      <div class="space-y-4">
        <div><strong>Q: 如何判斷貓咪已進入老齡？</strong><br>A: 通常 7-10 歲以上的貓咪被視為熟齡/高齡貓，需開始注意腎臟與關節健康。</div>
      </div>
    </article>

    <nav class="mt-12 py-8 border-t border-slate-200 flex justify-between items-center">
      <a href="/tools/dog-age-calculator" class="text-blue-600 font-bold hover:text-blue-800">← 狗狗年齡計算</a>
      <a href="/" class="text-slate-500 hover:text-slate-900">返回首頁</a>
    </nav>
  </div>

  <script>
    const btn = document.getElementById('calcBtn');
    const input = document.getElementById('catAge') as HTMLInputElement;
    const result = document.getElementById('result');

    btn?.addEventListener('click', async () => {
      const age = parseFloat(input.value);
      const res = await fetch('/api/calculate-age', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'cat', age }),
      });
      const data = await res.json();
      if (result) {
        result.textContent = `您的愛貓約等於人類 ${data.result} 歲`;
        result.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
