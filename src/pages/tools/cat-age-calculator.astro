  <script>
    const ageInput = document.getElementById('catAge') as HTMLInputElement;
    const resultDisplay = document.getElementById('result');
    const lifeStageText = document.getElementById('lifeStageText');
    const progressFill = document.getElementById('progressFill');

    const getStage = (age: number): { text: string; progress: number } => {
      if (age <= 0) return { text: 'å¹¼å¹´éæ®µ', progress: 5 };
      if (age === 1) return { text: 'éå°å¹´éæ®µ', progress: 10 };
      if (age === 2) return { text: 'æå¹´åæ', progress: 15 };
      if (age < 7) return { text: 'æå¹´æ', progress: 20 + (age - 2) * 8 };
      if (age < 10) return { text: 'çé½¡æ', progress: 60 + (age - 7) * 10 };
      return { text: 'èå¹´æ', progress: Math.min(90 + (age - 10) * 3, 100) };
    };

    const update = () => {
      const age = parseInt(ageInput.value) || 0;
      const humanAge = age <= 0 ? 0 : age === 1 ? 15 : age === 2 ? 24 : 24 + (age - 2) * 4;
      const { text, progress } = getStage(age);

      if (resultDisplay) resultDisplay.textContent = `${humanAge} æ­²`;
      if (lifeStageText) lifeStageText.textContent = `å·²é²å¥ ${text}`;
      if (progressFill) progressFill.style.width = `${progress}%`;
    };

    ageInput.addEventListener('input', update);
    update();
