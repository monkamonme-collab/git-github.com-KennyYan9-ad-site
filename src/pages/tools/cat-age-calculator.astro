---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';
import Card from '../../components/Card.astro';

const title = "貓咪人類年齡換算計算機 | 專業貓齡對照表";
const description = "想知道您的愛貓等於人類幾歲嗎？採用 AVMA 科學演算法，精準換算貓咪年齡。包含貓咪生命階段照護指南與常見的老化徵兆分析。";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-3xl mx-auto mt-12 px-6">
    <Card className="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-6">{title}</h1>
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">貓咪歲數</label>
          <input type="number" id="catAge" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="輸入歲數">
        </div>
        <button id="calcBtn" class="w-full bg-blue-600 text-white py-4 rounded-xl font-bold hover:bg-blue-700 transition">開始換算</button>
        <div id="result" class="p-6 bg-blue-50 rounded-2xl text-center text-xl font-bold text-blue-900 hidden"></div>
      </div>
    </Card>

    <AdSenseAd format="rectangle" />

    <article class="prose prose-slate max-w-none mt-12">
      <h2 id="why-calculate">為什麼要計算貓咪的換算年齡？</h2>
      <p>貓咪的生命週期與人類截然不同。根據研究，貓咪前兩年的成長最為迅猛，約在兩歲時就已經達到人類約 24 歲的發育成熟水平。了解愛貓目前處於哪個生命階段，是給予正確飲食規劃、預防醫學檢查的關鍵。</p>
      
      <h3 id="age-table">貓咪生命階段與人類對照</h3>
      <ul>
        <li><strong>幼貓期 (0-1歲)</strong>：社交行為與體格發育的黃金期。</li>
        <li><strong>成貓期 (2-7歲)</strong>：身體機能最穩定的巔峰期。</li>
        <li><strong>熟齡/高齡期 (7歲以上)</strong>：代謝減緩，需開始注意腎臟病、牙科問題與關節保養。</li>
      </ul>

      <h2 id="faq">常見問題 (FAQ)</h2>
      <dl>
        <dt class="font-bold">Q: 室內貓壽命通常比較長嗎？</dt>
        <dd class="mb-4">A: 是的，室內貓避免了戶外的寄生蟲、傳染病與交通事故，平均壽命顯著長於室外貓。</dd>
        <dt class="font-bold">Q: 貓咪幾歲算老貓？</dt>
        <dd class="mb-4">A: 一般獸醫學上將 10 歲以上的貓咪定義為高齡貓。</dd>
      </dl>
    </article>
  </div>

  <script>
    const btn = document.getElementById('calcBtn');
    const input = document.getElementById('catAge') as HTMLInputElement;
    const result = document.getElementById('result');

    btn?.addEventListener('click', async () => {
      const age = parseFloat(input.value);
      const res = await fetch('/api/calculate-age', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'cat', age }),
      });
      const data = await res.json();
      if (result) {
        result.textContent = `您的愛貓約等於人類 ${data.result} 歲`;
        result.classList.remove('hidden');
      }
    });
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "貓咪人類年齡換算計算機",
    "description": "AVMA標準計算貓咪對應人類歲數與照護指南。"
  }
  </script>
</BaseLayout>
