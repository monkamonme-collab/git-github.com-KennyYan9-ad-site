---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';
import Card from '../../components/Card.astro';
---

<BaseLayout title="貓咪人類年齡換算計算機 | 專業貓齡對照表" description="想知道貓咪等於人類幾歲嗎？專業貓咪年齡換算器，提供詳細貓齡對照表與老貓照護指南。">
  <div class="max-w-3xl mx-auto mt-12 px-6">
    <Card className="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-6">貓咪年齡計算機</h1>
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">貓咪歲數</label>
          <input type="number" id="catAge" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg" placeholder="輸入貓咪歲數">
        </div>
        <button id="calcBtn" class="w-full bg-slate-900 text-white py-4 rounded-xl font-bold hover:bg-slate-800 transition">計算換算年齡</button>
        <div id="result" class="p-6 bg-blue-50 rounded-2xl text-center text-xl font-bold text-blue-900 hidden"></div>
      </div>
    </Card>

    <AdSenseAd format="rectangle" />

    <section class="prose prose-slate max-w-none mt-12">
      <h2>貓咪年齡對照表</h2>
      <p>貓咪前兩年成長速度最快，之後每過一年大約等於人類四歲...</p>
      <!-- 對照表與FAQ預留區 -->
    </section>
  </div>

  <script>
    const btn = document.getElementById('calcBtn');
    const input = document.getElementById('catAge') as HTMLInputElement;
    const result = document.getElementById('result');

    btn?.addEventListener('click', async () => {
      const age = parseFloat(input.value);
      const res = await fetch('/api/calculate-age', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'cat', age }),
      });
      const data = await res.json();
      if (result) {
        result.textContent = `貓咪約等於人類 ${data.result} 歲`;
        result.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
