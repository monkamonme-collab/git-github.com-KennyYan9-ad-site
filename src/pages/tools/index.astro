---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools');
---

<BaseLayout title="工具大全 | 專業實用工具箱">
  <main class="max-w-5xl mx-auto px-6 py-12">
    <header class="text-center mb-16">
      <h1 class="text-5xl font-extrabold text-slate-900 tracking-tight mb-4">專業工具箱</h1>
      <p class="text-xl text-slate-600">高效、精準、簡單的日常工具解決方案。</p>
    </header>

    <div class="grid md:grid-cols-3 gap-8">
      {allTools.map((tool) => (
        <a href={`/tools/${tool.id.replace('.json', '')}`} class="group bg-white rounded-3xl p-6 border border-slate-100 hover:shadow-xl transition-all duration-300">
          <img src={tool.data.image} alt={tool.data.title} class="w-16 h-16 object-cover rounded-2xl mb-6 shadow-sm" />
          <h2 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-600">{tool.data.title}</h2>
          <p class="text-slate-600 text-sm leading-relaxed">{tool.data.description}</p>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
