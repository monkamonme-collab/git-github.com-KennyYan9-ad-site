---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  schemaType?: string;
  hrefLangAlternates?: { lang: string; url: string }[];
}
const { title, description, canonicalPath = "", schemaType = "WebSite", hrefLangAlternates = [] } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://www.petaginghub.com";
const canonicalURL = new URL(canonicalPath || Astro.url.pathname, siteUrl).toString();
const isArticle = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog/';
const ogType = isArticle ? 'article' : 'website';
const effectiveSchemaType = isArticle ? "Article" : schemaType;
const schemaData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": effectiveSchemaType,
  "name": title,
  "description": description,
  "url": canonicalURL
});
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />

<!-- hreflang alternates -->
{hrefLangAlternates.map(alt => (
  <link rel="alternate" hreflang={alt.lang} href={alt.url} />
))}

<!-- Schema.org -->
<script type="application/ld+json" set:html={schemaData} />
