---
interface Props {
  format?: 'auto' | 'rectangle' | 'horizontal';
  className?: string;
  dataAdSlot?: string; // Optional: specify ad slot ID
}
const { format = 'auto', className = '', dataAdSlot } = Astro.props;
// Replace with your actual AdSense client ID
const adClient = "ca-pub-6107150024201925";
---
<!-- 設定 min-height 預留空間，防止廣告載入時頁面閃動 (CLS) -->
<div class={`adsense-wrapper my-6 p-2 bg-gray-50 border border-gray-100 rounded-lg text-center min-h-[250px] ${className}`}>
  <ins class="adsbygoogle"
       style="display:block; width:100%; height:100%;"
       data-ad-client={adClient}
       data-ad-slot={dataAdSlot} 
       data-ad-format={format}>
  </ins>
  <!-- The global script will handle window.adsbygoogle.push({}) -->
</div>
