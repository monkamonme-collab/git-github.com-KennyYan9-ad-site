---
interface Props {
  format?: 'auto' | 'rectangle' | 'horizontal';
  className?: string;
}
const { format = 'auto', className = '' } = Astro.props;
---
<div class={`adsense-wrapper my-6 p-2 bg-gray-50 border border-gray-100 rounded-lg text-center ${className}`}>
  <!-- AdSense Code Container -->
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
       data-ad-slot="YOUR_AD_SLOT_ID"
       data-ad-format={format}></ins>
  <script is:inline>
       (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
