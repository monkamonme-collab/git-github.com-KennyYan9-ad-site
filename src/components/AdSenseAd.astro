---
interface Props {
  format?: 'auto' | 'rectangle' | 'horizontal';
  className?: string;
}
const { format = 'auto', className = '' } = Astro.props;
---
<!-- 設定 min-height 預留空間，防止廣告載入時頁面閃動 (CLS) -->
<div class={`adsense-wrapper my-6 p-2 bg-gray-50 border border-gray-100 rounded-lg text-center min-h-[250px] ${className}`}>
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
       data-ad-slot="YOUR_AD_SLOT_ID"
       data-ad-format={format}></ins>
  <script is:inline>
       (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
