---
interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  className?: string;
}
const { title, description, image, link, className = "" } = Astro.props;
---
<div class={`bg-white border border-gray-100 rounded-2xl shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] p-8 ${className}`}>
  <a href={link} class="block">
    <div class="aspect-video overflow-hidden rounded-xl mb-4">
      <img src={image} alt={title} loading="lazy"
           class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    </div>
  </a>
  <h3 class="text-lg font-semibold mb-2 line-clamp-2">{title}</h3>
  <p class="text-gray-600 line-clamp-3">{description}</p>
</div>
