---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AdSenseAd from '../components/AdSenseAd.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { label: string; url: string }[];
}

const { title, description, breadcrumbs = [] } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <SEO title={title || "Pet Aging Hub - 寵物年齡與健康指南"} description={description || "簡單的工具與實用指南，幫助你了解狗狗和貓咪的老化過程、健康變化與老年照護需求。"} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🐾</text></svg>">
    <!-- Global AdSense Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">
    <!-- Header Ad Placement -->
    <div class="my-4 max-w-5xl mx-auto px-6">
      <AdSenseAd format="horizontal" />
    </div>
    
    <main class="flex-grow max-w-5xl mx-auto px-6 py-8">
      {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
      <slot />
    </main>

    <Footer />

    <!-- Footer Ad Placement -->
    <div class="bg-slate-100 py-4">
      <div class="max-w-5xl mx-auto px-6">
        <AdSenseAd format="horizontal" />
      </div>
    </div>
  </body>
</html>