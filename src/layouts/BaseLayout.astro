---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AdSenseAd from '../components/AdSenseAd.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { label: string; url: string }[];
  lang?: string;
  hrefLangAlternates?: { lang: string; url: string }[];
  canonicalUrl?: string;
}

const {
  title,
  description,
  breadcrumbs = [],
  lang = 'zh-TW',
  hrefLangAlternates = [],
  canonicalUrl,
} = Astro.props;

const siteUrl = "https://git-github-com-kenny-yan9-ad-site.vercel.app";
const isEnglish = lang === 'en';

// 語言切換目標：從 hrefLangAlternates 找到另一語言的 URL，否則使用預設
const altLangCode = isEnglish ? 'zh-TW' : 'en';
const altEntry = hrefLangAlternates.find(a => a.lang === altLangCode);
const switcherUrl = altEntry?.url ?? (isEnglish ? siteUrl + '/' : siteUrl + '/en/tools/');
const switcherLabel = isEnglish ? '中文' : 'EN';

// 首頁 URL 依語言
const homeUrl = isEnglish ? '/en/tools/' : '/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEO
      title={title || "Pet Aging Hub - 寵物年齡與健康指南"}
      description={description || "簡單的工具與實用指南，幫助你了解狗狗和貓咪的者化過程、健康變化與老年照護需求。"}
    />

    <!-- hreflang 雙向互指 -->
    {hrefLangAlternates.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.url} />
    ))}

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2TX7MK0D1Q"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2TX7MK0D1Q');
    </script>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🐾</text></svg>">

    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6107150024201925"
      crossorigin="anonymous"
    ></script>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">

    <!-- 頂部導覽列（含語言切換） -->
    <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-100 shadow-sm">
      <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
        <!-- 網站 Logo -->
        <a href={homeUrl} class="flex items-center gap-2 font-bold text-slate-800 hover:text-blue-600 transition-colors">
          <span class="text-xl">🐾</span>
          <span class="text-base">Pet Aging Hub</span>
        </a>

        <!-- 語言切換按鈕 -->
        <a
          href={switcherUrl}
          class="flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-blue-600 border border-slate-200 hover:border-blue-400 bg-white hover:bg-blue-50 rounded-lg px-3 py-1.5 transition-all"
          aria-label={isEnglish ? '切換至繁體中文' : 'Switch to English'}
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
          </svg>
          <span>{switcherLabel}</span>
        </a>
      </div>
    </nav>

    <!-- 頂部廣告 -->
    <div class="my-4 max-w-5xl mx-auto px-6">
      <AdSenseAd format="horizontal" />
    </div>

    <main class="flex-grow max-w-5xl mx-auto px-6 py-8">
      {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
      <slot />
    </main>

    <Footer />

    <div class="bg-slate-100 py-4">
      <div class="max-w-5xl mx-auto px-6">
        <AdSenseAd format="horizontal" />
      </div>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('error', function(e) {
          var el = e.target;
          if (el.tagName === 'IMG' && !el.dataset.f) {
            el.dataset.f = 'true';
            var w = el.width || el.getAttribute('width') || '800',
                h = el.height || el.getAttribute('height') || '600';
            var s = '<svg xmlns="http://www.w3.org/2000/svg" width="' + w + '" height="' + h + '" viewBox="0 0 ' + w + ' ' + h + '"><rect width="100%" height="100%" fill="#e5e7eb"/><line x1="0" y1="0" x2="' + w + '" y2="' + h + '" stroke="#9ca3af" stroke-width="20"/><line x1="' + w + '" y1="0" x2="0" y2="' + h + '" stroke="#9ca3af" stroke-width="20"/></svg>';
            el.src = 'data:image/svg+xml,' + encodeURIComponent(s);
          }
        }, true);
      });
    </script>
  </body>
</html>
