---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { label: string; url: string }[];
}

const { title, description, breadcrumbs = [] } = Astro.props;
---
<!doctype html>
<html lang="zh-TW">
  <SEO title={title || "ToolKit"} description={description || "專業 SaaS 工具平台"} />
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">
    <nav class="bg-white border-b">
      <div class="max-w-5xl mx-auto px-6 py-4">
        <a href="/" class="font-bold text-xl">ToolKit</a>
      </div>
    </nav>
    <main class="flex-grow max-w-5xl mx-auto px-6 py-8">
      {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
      <slot />
    </main>
    <footer class="border-t bg-white py-12">
      <div class="max-w-5xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
        <a href="/about" class="block hover:text-blue-600">關於我們</a>
        <a href="/privacy" class="block hover:text-blue-600">隱私權政策</a>
        <a href="/terms" class="block hover:text-blue-600">使用條款</a>
      </div>
    </footer>
  </body>
</html>
