---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AdSenseAd from '../components/AdSenseAd.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { label: string; url: string }[];
  lang?: string;
  hrefLangAlternates?: { lang: string; url: string }[];
}

const { title, description, breadcrumbs = [], lang = 'zh-TW', hrefLangAlternates = [] } = Astro.props;

const isEnglish = lang === 'en';
const switcherTarget = isEnglish
  ? hrefLangAlternates.find(a => a.lang === 'zh-TW')?.url ?? '/'
  : hrefLangAlternates.find(a => a.lang === 'en')?.url ?? null;
const switcherLabel = isEnglish ? '繁中' : 'EN';
---

<!doctype html>
<html lang={lang}>
<head>
  <SEO
    title={title || "Pet Aging Hub - 寵物年齡與健康指南"}
    description={description || "簡單的工具與實用指南，幫助你了解狗狗和貓咪的老化過程、健康變化與老年照護需求。"}
    canonicalPath={Astro.url.pathname}
    hrefLangAlternates={hrefLangAlternates}
  />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-2TX7MK0D1Q"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-2TX7MK0D1Q');
  </script>

  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🐾</text></svg>">

  <script
    async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6107150024201925"
    crossorigin="anonymous"
  ></script>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">

  <!-- Navigation Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-bold text-slate-900 hover:text-blue-600 transition-colors">
        <span class="text-xl">🐾</span>
        <span class="text-sm font-semibold hidden sm:inline">{isEnglish ? 'Pet Aging Hub' : '寵物年齡健康中心'}</span>
      </a>

      <div class="flex items-center gap-4">
        <nav class="hidden sm:flex items-center gap-4 text-sm">
          <a href="/tools" class="text-slate-600 hover:text-blue-600 transition-colors font-medium">
            {isEnglish ? 'Tools' : '工具集'}
          </a>
          <a href="/blog" class="text-slate-600 hover:text-blue-600 transition-colors font-medium">
            {isEnglish ? 'Blog' : '部落格'}
          </a>
        </nav>

        {switcherTarget && (
          <a
            href={switcherTarget}
            class="flex items-center gap-1 px-3 py-1.5 text-xs font-semibold rounded-full border border-slate-300 text-slate-600 hover:border-blue-400 hover:text-blue-600 hover:bg-blue-50 transition-all"
            title={isEnglish ? '切換至繁體中文' : 'Switch to English'}
          >
            <span>🌐</span>
            {switcherLabel}
          </a>
        )}
      </div>
    </div>
  </header>

  <div class="my-4 max-w-5xl mx-auto px-6">
    <AdSenseAd format="horizontal" />
  </div>

  <main class="flex-grow max-w-5xl mx-auto px-6 py-8">
    {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
    <slot />
  </main>

  <Footer />

  <div class="bg-slate-100 py-4">
    <div class="max-w-5xl mx-auto px-6">
      <AdSenseAd format="horizontal" />
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      document.addEventListener('error', function(e) {
        var el = e.target;
        if (el.tagName === 'IMG' && !el.dataset.f) {
          el.dataset.f = 'true';
          var w = el.width || el.getAttribute('width') || '800',
              h = el.height || el.getAttribute('height') || '600';
          var s = '<svg xmlns="http://www.w3.org/2000/svg" width="' + w + '" height="' + h + '" viewBox="0 0 ' + w + ' ' + h + '"><rect width="100%" height="100%" fill="#e5e7eb"/><line x1="0" y1="0" x2="' + w + '" y2="' + h + '" stroke="#9ca3af" stroke-width="20"/><line x1="' + w + '" y1="0" x2="0" y2="' + h + '" stroke="#9ca3af" stroke-width="20"/></svg>';
          el.src = 'data:image/svg+xml,' + encodeURIComponent(s);
        }
      }, true);
    });
  </script>
</body>
</html>
